# ext4 image for the microSD root filesystem. Generated by Buildroot rather
# than mke2fs -d so ownership and the permission/device table are applied under
# fakeroot; the target/ tree itself is owned by the build user and has
# /etc/shadow at mode 644.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# Small on purpose: every byte is written over serial to a card doing ~1.7 MB/s
# during imaging, and read back again to verify. 512M cost ~9 min of writing
# zeros for a filesystem using 51M. S01s31-growroot resizes to fill the card on
# first boot, so the running system is no smaller.
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
BR2_TARGET_ROOTFS_EXT2_LABEL="s31root"
# 4 KiB blocks, not mkfs.ext4's small-filesystem default of 1 KiB. Block group
# size scales with block size (8 blocks/group * blocksize), so 1 KiB blocks give
# 8 MiB groups - 952 of them once growroot expands onto a 7.6 GB card, and
# ext4_groupinfo_1k then costs ~112 KiB of permanently unreclaimable slab. At
# 4 KiB it is 128 MiB groups, ~60 of them, ~7 KiB of slab. The cost is more
# slack per file, which is irrelevant next to 105 KiB of RAM here.
# resize2fs preserves the block size, so growroot keeps this on the grown
# filesystem too.
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-b 4096"
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_64K=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
# BR2_TARGET_ROOTFS_TAR is not set

# Weston and the Wayland stack are GONE. The desktop is X11: Weston's closure
# was 6,894,592 bytes and adding the toolkit a desktop needs took it to
# 12,322,960 against 7.4 MB of XIP flash. Kept out entirely rather than built
# and unused - an unused package still lands in the rootfs image and still has
# to be excluded from every staging decision by hand.
# foot is Wayland-native and has no compositor to talk to; st replaced it.
BR2_PACKAGE_HOST_CRAMFS=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_NNN=y
BR2_PACKAGE_BC=y
# ---------------------------------------------------------------------------
# X11 desktop. This replaces Wayland rather than joining it - see
# docs/desktop-plan.md. Weston is still built above only as a fallback until
# Xfbdev is confirmed painting on the panel; it costs nothing on the SD rootfs,
# and only the XIP flash images are budget-constrained. Drop it once proven.
#
# Measured: Xfbdev 1.60 MB, X client libs 1.92 MB, FLTK 1.28 MB.
# Cairo was for Weston's clients. Nothing in this desktop draws with it.
# BR2_PACKAGE_CAIRO_XLIB is not set
# FLTK is OFF. libfltk.so.1.3 has DT_NEEDED libstdc++.so.6, and
# post-build.sh deletes libstdc++ from the target - so every byte of it was
# unloadable on the board, including the 1,323,008 it occupied in XIP image 2.
# The file manager is xfiles instead, which needs no C++ at all.
# BR2_PACKAGE_FLTK is not set

# Xft must be asked for explicitly. Neither FLTK nor xterm selects it - both
# test for it and silently fall back to core bitmap fonts when it is absent
# (FLTK's .mk and xterm's --disable-freetype). With it off, "proper desktop
# apps" means unantialiased fixed-pitch bitmaps and DejaVu is unreachable.
# It is 83 KB; freetype and fontconfig are already paid for by the server.
# Xorg with the builtin modesetting driver, replacing Xfbdev. Xfbdev goes
# through fbdev emulation and its 50 ms deferred-I/O timer, which caps any
# client at 20 fps; modesetting talks DRM directly with dumb buffers and atomic
# commits - exactly the path Weston used on this driver. The reason for trying
# it is memory, not the cap: Xfbdev is 2,876 kB resident with no clients
# connected, dominated by a single 2,456 kB anonymous mapping, and the desktop's
# working set does not fit in 15,456 kB as a result.
# X11Libre's Xfbdev stays built for now so the two can be compared on hardware
# before one is removed.
# X11Libre's Xfbdev is off: superseded by Xorg with the modesetting driver.
# Xfbdev went through fbdev emulation, whose 50 ms deferred-I/O timer caps any
# client at 20 fps, and was 2,876 kB resident before a single client connected.
# BR2_PACKAGE_X11LIBRE_XSERVER is not set


# evilwm is about 30 KB and gives real window management - move, resize, focus,
# virtual desktops - without a toolkit, a config parser or an icon theme.
# jwm replaces evilwm. evilwm draws a one-pixel border and nothing else - no
# title bars, no close/maximise/minimise, no taskbar - which is not a desktop.
# fluxbox and openbox have those but are C++, and would bring libstdc++ back to
# a board that now has no C++ runtime at all. jwm is C against Xlib and reuses
# libX11, libXft and libXpm already in flash.
# st replaces xterm. xterm's Athena chain - xterm, libXaw7, libXt, libXmu,
# libXpm, libncursesw, libICE, libSM - is 1,957,904 bytes and does not fit the
# XIP image, so it paged off the SD card on every window redraw. Measured during
# a redraw: xterm took 72 major faults and the server 66. st draws with Xft and
# needs only libX11, libXft, fontconfig and freetype, all already in flash.
BR2_PACKAGE_ST=y

# ---------------------------------------------------------------------------
# libX11 alone - for the X11 shim inside lvdesk, NOT for running a server.
#
# The plan is option 2 from the desktop notes: lvdesk speaks enough of the X11
# core protocol itself, so off-the-shelf clients connect to it directly and
# their windows become lvdesk windows. No server process, no server heap - the
# measured heft of X here was never the code (1.92 MB of client libs sat in XIP
# at zero RSS) but the server's anonymous memory: Xfbdev was 2,876 kB resident
# with no clients at all, dominated by one 2,456 kB mapping.
#
# The whole xclock chain, on purpose - libXaw, libXft, libXrender, libxkbfile.
#
# The first instinct was to take libX11 only and refuse RENDER so clients fell
# back to core fonts. That is backwards. With Xft the CLIENT rasterises glyphs
# through freetype and uploads them as A8 masks (RenderAddGlyphs); the server
# only stores and composites them. So supporting RENDER means no font files on
# the board, no font matching and no QueryFont metrics tables - strictly less
# work than core fonts, and it generalises to every Xft app rather than to the
# handful that still fall back.
#
# XKB is still refused: Xlib has a core-keyboard path when the extension is
# absent. Xaw and Xt are client-side and need nothing from the server beyond
# the core protocol.
#
# These live on the SD card for now, not in XIP - they are for bringing the
# shim up, and the ~2.7 MB chain does not fit the flash images as they stand.
# The x11r7 packages are gated behind this master switch - without it
# BR2_PACKAGE_XLIB_LIBX11 is silently ignored, which is the Buildroot trap the
# notes warn about: always grep the generated .config, never trust the
# defconfig. It enables the menu only; nothing is built that is not selected.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XAPP_XCLOCK=y

# A second and a third client, for the shim's diagnostics rather than for the
# desktop. xclock draws with three primitives and asks for nothing hard, so it
# proves almost nothing about what the shim does when a client wants something
# it has not implemented. xcalc is a full Athena widget app - buttons, labels,
# text - and xdpyinfo does nothing BUT ask the server about itself, so between
# them they walk into every gap there is. Both are test instruments here.
BR2_PACKAGE_XAPP_XCALC=y

# The classic X "fixed" bitmap fonts - 6x13, 8x13, 9x15 and friends.
#
# Enabled for their BDF SOURCES, which tools/mkxshimfont.py turns into C tables
# compiled into lvdesk. The shim does not read font files at runtime: it has no
# PCF parser, and a font in lvdesk's XIP text costs zero RSS where a file read
# off the card costs page cache and latency. The installed .pcf.gz go to the SD
# rootfs and nothing uses them.
# NOTE: BR2_SHARED_STATIC_LIBS was enabled here once, to measure whether
# --gc-sections could shrink the X client stack enough to fit XIP flash. It
# can, partly: a fully static, stripped xcalc is 1,708,648 bytes against ~2.9 MB
# of shared objects. That is still ~550 kB more than the flash that can be
# reclaimed, so it does not close the gap on its own - and it doubles the SD
# rootfs (13.8 -> 23 MB) by installing every .a. Reverted; the number is
# recorded in docs/x11-shim.md.

# Drop DT_NEEDED entries nothing references.
#
# libXt, libXmu, libXext and libXpm each record a dependency on libxcb.so.1 and
# use ZERO xcb_* symbols - pkg-config hands the linker x11's transitive
# libraries and the linker records them regardless. The loader honours the
# entry, so every X client maps 72 kB of libxcb for nothing. That matters here
# for the same reason everything else does: it is 72 kB of text paged off the
# SD card on a board with ~3 MB free.
# -Bsymbolic-functions for EVERY shared library on the board, not just Qt.
#
# musl has no lazy PLT: it resolves every symbol eagerly at load, walking the
# DSO list once per symbol. A sampling profiler puts 73-78% of a Qt cold start
# inside libc.so, and the hot addresses resolve to gnu_lookup_filtered - that
# lookup. The same tax is paid by every dynamically linked program here, it is
# just most visible on the largest one.
#
# -Bsymbolic-functions binds a library's calls to its OWN functions at link
# time, so the loader never looks them up. Measured on Qt alone, relocations
# fell 45,430 -> 35,079 (-23%): Core -36%, Gui -30%, Widgets -16%.
#
# Cost: a library can no longer have its internal function calls interposed.
# Only FUNCTION references are bound, not data, so vtables and typeinfo stay
# interposable and C++ RTTI across DSOs still works - which is why this is the
# -functions variant and not plain -Bsymbolic. Nothing on this board LD_PRELOADs
# over a library's internals; rootfs/ioctlprof.c interposes libc's ioctl, and
# libc comes from the external toolchain, so it is not affected.
BR2_TARGET_LDFLAGS="-Wl,--as-needed -Wl,-Bsymbolic-functions"

BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
# Adobe Symbol, for the mathematical glyphs clients select per-GC (xcalc's
# radical sign and pi). Also source-only, for the same reason.
BR2_PACKAGE_XFONT_FONT_ADOBE_75DPI=y
BR2_PACKAGE_XAPP_XDPYINFO=y

# xcalc: the calculator, off the shelf. It is an Athena app, so it brings back
# libXaw7 (346,108), libXt (316,096) and libXmu (87,752) that leaving xterm
# removed. That is ~750 kB for one application, which is only worth it because
# nothing smaller exists off the shelf - and unlike xterm's chain it is not on
# the redraw-hot path, so it can page from the card without being felt.

# xfiles: the file manager. Raw Xlib, C99, no toolkit and no C++. Of its
# dependencies only libXpm is not already in flash for the server.
BR2_PACKAGE_XFILES=y

# Core bitmap fonts. xterm and any Xt app need "fixed" to start at all, and
# these are tens of KB against a scalable face's several hundred.
# The root pointer is drawn from the font literally named "cursor", which lives
# in font-cursor-misc and NOT in font-misc-misc. Without it the server still
# starts - it does not complain - so a missing pointer looks like broken input
# rather than a missing font. This Xfbdev has no -fc option to redirect it.

# DejaVu Sans as well as Mono: FLTK renders through Xft, which needs a scalable
# face, and Mono alone leaves proportional text unresolvable.
#
# The serif and condensed families default to y and are 4.9 MB of the 9.6 MB
# DejaVu otherwise installs - measured, per file. Nothing here asks for them:
# FLTK's default faces map to sans and mono, and xterm uses mono. They are not
# free even sitting unused, because fontconfig scans the whole directory and
# every file it finds is read off the SD card.
BR2_PACKAGE_DEJAVU_SANS=y
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set

# The server needs a keymap compiled at runtime, so xkbcomp and the rule files
# have to be on the target. This is the one unmeasured cost in the plan.

# xsetroot paints the root window; without it X starts on the stipple pattern
# and it is genuinely hard to tell a working server from a half-broken one.

# Buildroot's default wget line sets --connect-timeout but no --read-timeout,
# so a server that accepts the connection and then stops sending hangs forever:
# the retry count never decrements and the mirror fallback never runs. Seen with
# http://cairographics.org/releases, which stalled a build for 30 minutes.
# Note the primary URL uses the http+ prefix, forcing plain HTTP; the same file
# over HTTPS downloads in seconds. Bound the read so a stall fails over.
BR2_WGET="wget -nd -t 3 --connect-timeout=15 --read-timeout=30"

# No package manager. opkg was here and is REMOVED (2026-08-29) - it never met
# the need it was added for.
#
# The reasoning that put it here still stands as far as it goes: opkg is the
# only real candidate Buildroot offers, and this target is riscv32 ilp32 with a
# custom vendor extension (xespv2p2), so no upstream feed exists or ever will -
# every package has to come from our own Buildroot output. That is exactly why
# it never paid: building a feed from Buildroot is the whole cost of a rebuild,
# and once you are rebuilding you may as well ship the image.
#
# What it cost, and this is why it went: opkg drags libarchive (623,772),
# libopkg (174,424) and their share of libexpat and libz, and that chain was
# sitting in XIP FLASH - the scarcest resource on the board - for a program run
# interactively and rarely. Evicting it is what made room for bluetoothd, which
# never exits and was the largest RSS on the board. See the XIP2_ROOTS note in
# the Makefile for the arithmetic.
#
# docs/packaging.md describes the feed workflow and is kept for the record.
# BR2_PACKAGE_OPKG is not set
# BR2_PACKAGE_HOST_OPKG_UTILS is not set

# Timezone. The board is in the UK, so BST has to be handled - and handled the
# normal way, from the zoneinfo database, rather than by hardcoding an offset
# that is wrong for half the year. TZ_ZONELIST trims the database to one
# region; the full set is several MB of zones this board will never be in.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="europe"
BR2_TARGET_LOCALTIME="Europe/London"
BR2_PACKAGE_XAPP_OCLOCK=y

# Qt5, staged on the SD card rather than in XIP flash.
#
# This is a deliberate experiment, not a shipping choice: the flash is fully
# partitioned at 16 MB with ~370 KB of XIP slack, and qt5base alone is an order
# of magnitude larger than that, so Qt CANNOT go in XIP as things stand. The
# point is to find out how an off-the-shelf toolkit behaves when it is paged
# off SD - see docs/current-state.md on why request size, not bandwidth, is
# what that costs.
#
# Every hard prerequisite was ALREADY satisfied before adding this, which is
# why the delta is small: BR2_INSTALL_LIBSTDCPP, LIBXCB, XLIB_LIBXEXT,
# FONTCONFIG, FREETYPE, wchar, NPTL threads and dynamic libs are all on for the
# existing X clients. Only the xcb-util family, xkbcommon and Qt itself are new.
#
# xcb, not linuxfb or eglfs. There is no /dev/fb0 on this board (fbdev
# emulation was dropped when lvdesk started driving KMS directly) and no GL, so
# those two plugins have nothing to render into. lvdesk speaks the X11 core
# protocol itself, so xcb is the only surface Qt can reach.
#
# libxkbcommon is REQUIRED even though lvdesk refuses the XKB extension. Qt
# 5.15's QXcbKeyboard tries xkb_x11_keymap_new_from_device first and falls back
# to xkb_keymap_new_from_names when the server has no XKB, building the keymap
# client-side from xkeyboard-config's rules. Without the library there is no
# fallback to take.
#
# ICU is deliberately OFF - it is tens of megabytes and Qt only needs it for
# full Unicode collation. OpenGL is off because there is no GPU.
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE_GUI=y
BR2_PACKAGE_QT5BASE_WIDGETS=y
BR2_PACKAGE_QT5BASE_XCB=y
BR2_PACKAGE_QT5BASE_FONTCONFIG=y
BR2_PACKAGE_QT5BASE_PNG=y
BR2_PACKAGE_QT5BASE_JPEG=y
BR2_PACKAGE_QT5BASE_DEFAULT_QPA="xcb"
BR2_PACKAGE_QT5BASE_EXAMPLES=y

# Build Qt so that LOADING it is cheap. Measured on the board with the caches
# warm, so this is pure CPU and not SD: dlopen(RTLD_NOW) of libQt5Core is
# 1.88 s, of Gui 3.57 s, of Widgets 11.91 s - musl has no lazy PLT and binds
# every symbol eagerly, so each library added slows every later lookup. The
# three libraries carry 26,485 dynamic symbols and 45,430 relocations between
# them, and Buildroot passes neither of the options Qt provides for exactly
# this. Both are QT-side: the soname, the public API and the ABI are unchanged,
# so off-the-shelf application binaries keep working untouched - which is the
# whole point, since static linking would have meant rebuilding every app.
#
#   -reduce-exports      -fvisibility=hidden, so only Qt's public API reaches
#                        the dynamic symbol table instead of every internal
#                        symbol. Smaller tables make every lookup cheaper.
# -reduce-relocations (-Bsymbolic-functions) was tried and REFUSED by Qt's own
# configure on this toolchain: "Feature 'reduce_relocations' was enabled, but
# the pre-condition '!config.win32 && tests.reduce_relocations' failed" - the
# compile test does not pass for riscv32 here. Do not re-add it without making
# that test pass first; enabling it only turns a working build into a failing
# one at the very end of a long configure.
# -Bsymbolic-functions passed DIRECTLY as a qmake linker flag.
#
# Qt's own -reduce-relocations does exactly this, and its configure REFUSES it
# here ("pre-condition tests.reduce_relocations failed") - but that is Qt's
# compile test failing on riscv32, not the linker flag being unsupported. The
# flag binds Qt's calls to its own symbols at LINK time, so the loader never
# looks them up.
#
# Why it matters, measured: a sampling profiler puts 73-78% of QApplication's
# CPU inside libc.so, and the hot addresses resolve to gnu_lookup_filtered -
# musl's symbol lookup, called once per DSO per symbol, with no lazy binding to
# avoid it. Qt's three libraries carry 26,485 dynamic symbols between them.
#
# Cost: symbol interposition is lost, so LD_PRELOAD over Qt internals stops
# working. Nothing here does that.
BR2_PACKAGE_QT5BASE_CUSTOM_CONF_OPTS="-reduce-exports QMAKE_LFLAGS+=-Wl,-Bsymbolic-functions"

# Modules nothing on this board uses. Each one is a whole library that the
# loader would otherwise have to map and bind before the app starts.
# BR2_PACKAGE_QT5BASE_NETWORK is not set
# BR2_PACKAGE_QT5BASE_SQL is not set
# BR2_PACKAGE_QT5BASE_TEST is not set
# BR2_PACKAGE_QT5BASE_XML is not set
