#!/bin/sh
#
# Bring up the X11 desktop, one component at a time.
#
# Deliberately not a startx script. Each stage is started and checked
# separately, because the failure that matters here - whether Xfbdev's writes
# to /dev/fb0 actually reach the DRM plane update path - looks identical to a
# window manager crash or a missing font if the whole stack is launched at once
# and only the end result is observed.
#
#   s31-desktop            server + wm + a terminal
#   s31-desktop server     just the server, to test paint in isolation
#   s31-desktop stop
#
# /dev/fb0 on this board is the DRM driver's fbdev emulation, so the server
# inherits the reduced render size (see the lcd driver's render= parameter) and
# the 1:1 centred placement rather than a stretched upscale. Do not pass
# -screen: forcing a size here would silently undo that.

DISPLAY=:0
export DISPLAY
XSRV=/usr/bin/Xfbdev
LOG=/tmp/xfbdev.log

die() { echo "s31-desktop: $*" >&2; exit 1; }

# Match pointers on capability bits, not on the Handlers list: the "mouse"
# handler comes from mousedev, which this kernel does not build, so a working
# USB mouse shows only "Handlers=event0". A pointer advertises REL_X (0x1) and
# REL_Y (0x2) - the low two bits of its REL mask. Testing the last hex digit
# avoids strtonum, which busybox awk lacks.
find_inputs() {
	want=$1
	awk -v want="$want" '
		/^I:/  { hand=""; rel="" }
		/^H: Handlers=/ { hand=$0 }
		/^B: REL=/ { rel=substr($2, 5) }
		/^$/ {
			if (hand ~ /event/) {
				n = hand; sub(/.*(event)/, "event", n); sub(/ .*/, "", n)
				last = tolower(substr(rel, length(rel), 1))
				ptr = (rel != "" && (last == "3" || last == "7" || \
				       last == "b" || last == "f"))
				if (want == "mouse" && ptr) print "/dev/input/" n
				if (want == "kbd" && !ptr && hand ~ /kbd/) print "/dev/input/" n
			}
		}
	' /proc/bus/input/devices 2>/dev/null
}

# fontconfig ships no cache, and buildroot cannot build one for us: its caches
# are architecture-specific, so a host-generated cache would be wrong here.
# Without it every Xft lookup walks the whole font directory and reads each face
# off the SD card - the exact cost this board has spent the most effort
# reducing. Build it once and keep it; /var is on the card and persists.
warm_font_cache() {
	command -v fc-cache >/dev/null 2>&1 || return 0
	[ -d /var/cache/fontconfig ] && [ -n "$(ls -A /var/cache/fontconfig 2>/dev/null)" ] && return 0
	echo "s31-desktop: building font cache (one time, slow)..."
	mkdir -p /var/cache/fontconfig
	fc-cache -f >/dev/null 2>&1
	sync
	echo "s31-desktop: font cache built"
}

start_server() {
	[ -x "$XSRV" ] || die "$XSRV missing - is the XIP overlay mounted?"
	[ -c /dev/fb0 ] || die "/dev/fb0 missing - is DRM fbdev emulation on?"
	pidof Xfbdev >/dev/null 2>&1 && die "Xfbdev already running"
	warm_font_cache

	# Name the font path explicitly. The default list also contains 100dpi,
	# 75dpi and cyrillic, which the font-alias package creates as alias-only
	# stubs with no fonts.dir; the server probes each off the SD card and then
	# drops it with a warning. Only misc has real fonts here - 334 pcf files
	# and the "fixed" alias every Xt application needs to start.
	FP=/usr/share/fonts/X11/misc
	# Input devices are named explicitly, and -seat is NOT used, because
	# kdrive's udev enumeration is broken in this build. Measured, same
	# virtual mouse, one variable changed:
	#
	#     -seat seat0 (udev)      pointer frozen at (41,177) for 12 samples
	#     -mouse evdev,,device=   pointer moves: 81 129 235 297 307 242 175
	#
	# With -seat the server enumerates devices, opens them - three fds, and
	# it hotplugs new ones correctly - and then never delivers their events.
	# That leaves the desktop with no working input at all, including the
	# real mouse, and nothing in the log says so. Do not "simplify" this back
	# to -seat without re-running that A/B.
	#
	# Every matching device is passed rather than the first, because a
	# wireless keyboard publishes a phantom mouse and a mouse receiver
	# publishes a consumer-control keyboard, so picking one is a coin toss
	# decided by USB enumeration order:
	#
	#     event0  Logitech USB Receiver                   REL=1943  pointer
	#     event1  Logitech USB Receiver Consumer Control  REL=1040  keyboard
	#     event2  8BitDo Retro Keyboard Receiver          REL=1943  pointer (phantom)
	#     event3  8BitDo Retro Keyboard Receiver Keyboard REL=1040  keyboard
	#
	# kdrive merges them all into the core pointer and keyboard, so a
	# phantom that never moves contributes nothing.
	nk=0; nm=0
	for k in $(find_inputs kbd); do
		args="$args -keybd evdev,,device=$k"; nk=$((nk+1))
	done
	for m in $(find_inputs mouse); do
		args="$args -mouse evdev,,device=$m"; nm=$((nm+1))
	done
	[ "$nk" = 0 ] && echo "s31-desktop: WARNING no keyboard found"
	[ "$nm" = 0 ] && echo "s31-desktop: WARNING no pointer found"
	echo "s31-desktop: $nk keyboard(s), $nm pointer(s)"
	echo "s31-desktop: $XSRV $args"

	$XSRV $args >"$LOG" 2>&1 &
	# The server has to create the socket before any client can connect;
	# polling for it beats a fixed sleep, which is either racy or slow.
	i=0
	while [ $i -lt 100 ]; do
		[ -S /tmp/.X11-unix/X0 ] && break
		pidof Xfbdev >/dev/null 2>&1 || { echo "--- $LOG ---"; cat "$LOG"; die "server exited"; }
		i=$((i+1))
		usleep 100000 2>/dev/null || sleep 1
	done
	[ -S /tmp/.X11-unix/X0 ] || { echo "--- $LOG ---"; cat "$LOG"; die "no socket after 10s"; }
	echo "s31-desktop: server up on $DISPLAY"
}

case "${1:-all}" in
server)
	start_server
	# A flat colour proves the paint path end to end: if this reaches the
	# panel, the server is talking to the plane. The stipple default is
	# hard to tell apart from a stale framebuffer.
	xsetroot -solid steelblue 2>/dev/null && echo "s31-desktop: root painted"
	# Xfbdev leaves the root cursor as None, so the pointer is invisible
	# and moving it damages nothing at all - which reads as dead input.
	xsetroot -cursor_name left_ptr 2>/dev/null
	;;
all)
	start_server
	xsetroot -solid steelblue 2>/dev/null || echo "s31-desktop: xsetroot failed"
	# -fn is not optional. evilwm's built-in default resolves against the
	# full core font path; with the path pinned to X11/misc it finds nothing
	# and exits with "couldn't find a font to use", which looks like a crash.
	evilwm -fn fixed >/tmp/evilwm.log 2>&1 &
	sleep 1
	pidof evilwm >/dev/null 2>&1 || echo "s31-desktop: WARNING evilwm did not start"
	xterm -fa 'DejaVu Sans Mono' -fs 9 -bg black -fg green &
	echo "s31-desktop: up. 's31-desktop stop' to tear down."
	;;
stop)
	for p in xterm evilwm Xfbdev; do killall "$p" 2>/dev/null; done
	echo "s31-desktop: stopped"
	;;
*)
	echo "Usage: $0 {all|server|stop}"; exit 1 ;;
esac
