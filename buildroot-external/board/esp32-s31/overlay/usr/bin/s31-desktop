#!/bin/sh
#
# Bring up the X11 desktop, one component at a time.
#
# Deliberately not a startx script. Each stage is started and checked
# separately, because a server that fails to find a screen looks identical to a
# window manager crash or a missing font if the whole stack is launched at once
# and only the end result is observed.
#
#   s31-desktop            server + wm + a terminal
#   s31-desktop server     just the server, to test paint in isolation
#   s31-desktop stop
#
# This is Xorg with the modesetting driver, talking to /dev/dri/card0 directly.
# It replaced kdrive's Xfbdev, which reached the panel through fbdev emulation -
# and that path is capped at 20 fps no matter what anything above it does,
# because deferred I/O damages the plane from a HZ/20 timer. Going straight to
# DRM removes the cap entirely. Everything about the mode comes from the
# connector, so there is still no -screen here: forcing a size would undo the
# driver's 1:1 centred placement (see its render= parameter).

DISPLAY=:0
export DISPLAY
XSRV=/usr/bin/Xorg
LOG=/tmp/xorg.log

die() { echo "s31-desktop: $*" >&2; exit 1; }

# fontconfig ships no cache, and buildroot cannot build one for us: its caches
# are architecture-specific, so a host-generated cache would be wrong here.
# Without it every Xft lookup walks the whole font directory and reads each face
# off the SD card - the exact cost this board has spent the most effort
# reducing. Build it once and keep it; /var is on the card and persists.
warm_font_cache() {
	command -v fc-cache >/dev/null 2>&1 || return 0
	[ -d /var/cache/fontconfig ] && [ -n "$(ls -A /var/cache/fontconfig 2>/dev/null)" ] && return 0
	echo "s31-desktop: building font cache (one time, slow)..."
	mkdir -p /var/cache/fontconfig
	fc-cache -f >/dev/null 2>&1
	sync
	echo "s31-desktop: font cache built"
}

start_server() {
	[ -x "$XSRV" ] || die "$XSRV missing - is the XIP overlay mounted?"
	[ -c /dev/dri/card0 ] || die "/dev/dri/card0 missing - is the DRM driver up?"
	pidof Xorg >/dev/null 2>&1 && die "Xorg already running"
	warm_font_cache

	# Name the font path explicitly. The default list also contains 100dpi,
	# 75dpi and cyrillic, which the font-alias package creates as alias-only
	# stubs with no fonts.dir; the server probes each off the SD card and then
	# drops it with a warning. Only misc has real fonts here - 334 pcf files
	# and the "fixed" alias every Xt application needs to start.
	FP=/usr/share/fonts/X11/misc
	# -keeptty is not optional here. Without it Xorg looks for a free VT to
	# take over, and this kernel is built without VT support at all - there
	# is no /dev/tty0 to open, so the server exits before it ever probes the
	# GPU. With it, Xorg stays on the tty it was launched from.
	#
	# No input device arguments: Xorg's config backend enumerates via udev
	# and handles hot-plug, the same as kdrive's did. Naming devices by hand
	# cannot work anyway, because a wireless keyboard publishes a phantom
	# mouse and a mouse receiver publishes a consumer-control keyboard, so
	# which node is "real" depends on USB enumeration order.
	args=":0 -keeptty -dpi 100 -nolisten tcp -logfile $LOG -config /etc/X11/xorg.conf"
	[ -f "$FP/fonts.dir" ] && args="$args -fp $FP"
	echo "s31-desktop: $XSRV $args"

	$XSRV $args >/tmp/xorg.stderr 2>&1 &
	# The server has to create the socket before any client can connect;
	# polling for it beats a fixed sleep, which is either racy or slow.
	i=0
	while [ $i -lt 100 ]; do
		[ -S /tmp/.X11-unix/X0 ] && break
		pidof Xorg >/dev/null 2>&1 || { echo "--- $LOG ---"; tail -30 "$LOG" 2>/dev/null; cat /tmp/xorg.stderr; die "server exited"; }
		i=$((i+1))
		usleep 100000 2>/dev/null || sleep 1
	done
	[ -S /tmp/.X11-unix/X0 ] || { echo "--- $LOG ---"; tail -30 "$LOG" 2>/dev/null; die "no socket after 10s"; }
	echo "s31-desktop: server up on $DISPLAY"
}

case "${1:-all}" in
server)
	start_server
	# A flat colour proves the paint path end to end: if this reaches the
	# panel, the server is talking to the plane. The stipple default is
	# hard to tell apart from a stale framebuffer.
	xsetroot -solid steelblue 2>/dev/null && echo "s31-desktop: root painted"
	# Set a real root cursor: with the root left as None the pointer is
	# invisible and moving it damages nothing at all, which reads as dead
	# input rather than as a missing cursor.
	xsetroot -cursor_name left_ptr 2>/dev/null
	;;
all)
	start_server
	xsetroot -solid steelblue 2>/dev/null || echo "s31-desktop: xsetroot failed"
	# jwm, not evilwm: evilwm draws a one-pixel border and nothing else, so
	# there is no title bar, no close/maximise/minimise and no taskbar. jwm
	# provides all three in C against Xlib, reusing libraries already in
	# flash, where fluxbox and openbox would drag libstdc++ back in.
	jwm >/tmp/jwm.log 2>&1 &
	sleep 2
	pidof jwm >/dev/null 2>&1 || echo "s31-desktop: WARNING jwm did not start"
	# st, not xterm. xterm's Athena chain - xterm, libXaw7, libXt, libXmu,
	# libXpm, libncursesw, libICE, libSM - is 1,957,904 bytes, does not fit
	# the flash image, and so paged off the SD card on every window redraw.
	# Measured during a redraw: 72 major faults in xterm, 66 in the server.
	# st is 179,504 and needs only libX11, libXft, fontconfig and freetype,
	# all already resident in flash for the server.
	st -f 'DejaVu Sans Mono:size=9' &
	echo "s31-desktop: up. 's31-desktop stop' to tear down."
	;;
stop)
	for p in st xfiles xcalc jwm Xorg; do killall "$p" 2>/dev/null; done
	echo "s31-desktop: stopped"
	;;
*)
	echo "Usage: $0 {all|server|stop}"; exit 1 ;;
esac
