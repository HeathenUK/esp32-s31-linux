# Loopback only.
#
# There is no eth0 on this board. The S31 has an Ethernet MAC, but the Korvo-1
# brings out no PHY, and networking comes from ESP-Hosted as wlan0. An
# "auto eth0 / iface eth0 inet dhcp" stanza was here and cost about 30 seconds
# of every boot: ifup -a blocked trying to DHCP an interface that will never
# exist, printing "Cannot find device eth0" and then failing.
#
auto lo
iface lo inet loopback

# wlan0 carries no credentials here - they live in /etc/wpa_supplicant.conf
# (mode 600), which is written on the device and deliberately kept out of this
# tree. The stanza itself is safe to ship, and shipping it is the point: it was
# previously configured by hand on the card, so a re-image silently lost the
# network.
#
# pre-up runs a helper rather than wpa_supplicant directly because ifupdown has
# no notion of waiting for a WPA association: it starts udhcpc the moment pre-up
# returns, while the hidden-SSID scan and handshake still have ~7 s to run. DHCP
# then times out and ifup reports the interface "already configured" with no
# address, which looks exactly like wrong credentials. Debian solves this with
# the wpasupplicant package's ifupdown glue; Buildroot does not ship it.
auto wlan0
iface wlan0 inet dhcp
	pre-up /etc/network/wlan0-up.sh
	post-down killall wpa_supplicant 2>/dev/null || true
