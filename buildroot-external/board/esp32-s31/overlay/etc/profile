export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export USER=root
export LOGNAME=root
# xfiles opens files via $OPENER (default xdg-open, not shipped). s31-open
# views files in the lvdesk terminal and detaches nested xfiles windows.
export OPENER=s31-open
# xfiles thumbnails on: it derives its cache from XDG_CACHE_HOME.
export XDG_CACHE_HOME=/root/.cache
# s31fp (rootfs/s31fp/v2): bit-exact, faster soft-double arithmetic for every
# dynamically linked program - libgcc's routines in the program's own text are
# found by their full bodies and redirected at load. S31FP=0 turns it off for
# a process; musl starts programs normally if the file is missing.
[ -r /usr/lib/libs31fp.so ] && export LD_PRELOAD=/usr/lib/libs31fp.so
# Validated v3 on SD, retaining the XIP v2 fallback above.
[ -r /etc/s31fp.env ] && . /etc/s31fp.env
