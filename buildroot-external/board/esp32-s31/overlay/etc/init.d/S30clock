#!/bin/sh
#
# Time, on a board with no real-time clock.
#
# The Korvo-1 has no RTC: no battery-backed chip on the I2C bus, and the SoC's
# RTC domain is not backed either, so a cold boot starts at the epoch. That is
# what made the desktop clock read 00:0x - it was showing uptime, honestly.
#
# Two halves, which is what every RTC-less Linux board does (Raspberry Pi OS
# ships exactly this pair):
#
#   1. A saved timestamp, restored at boot. It cannot be *right*, but it is
#      never absurd: the clock starts at the last time we knew, so file
#      timestamps stay ordered and TLS certificates do not appear to be from
#      the future. Never moves the clock backwards.
#   2. ntpd, which corrects it once the network is up.
#
# Ordered S30, before the desktop at S40. The timezone and the restored
# timestamp have to be in place before anything reads the clock: musl caches
# the zone on first use, so a desktop that starts first shows UTC for ever,
# and renaming this to run later is what put 12:23 on a 13:23 panel.
#
# Neither blocks the boot. ntpd is a daemon: it retries on its own schedule
# while the rest of userspace carries on, so a board with no network - or one
# whose Wi-Fi takes 60 s to associate, which is normal here - reaches the
# desktop at exactly the same speed as one with a working uplink.

STAMP=/var/lib/misc/fake-hwclock.data
SERVERS="pool.ntp.org time.cloudflare.com"

save_time() {
	mkdir -p "$(dirname $STAMP)"
	date -u '+%Y-%m-%d %H:%M:%S' > "$STAMP"
}

start() {
	printf "Restoring clock: "
	if [ -r "$STAMP" ]; then
		SAVED=$(cat "$STAMP")
		# Only ever forwards. If the current clock is already later -
		# ntpd got there first, or this is a warm reboot that kept the
		# time - leave it alone.
		NOW=$(date -u '+%Y-%m-%d %H:%M:%S')
		if [ "$SAVED" \> "$NOW" ]; then
			date -u -s "$SAVED" >/dev/null 2>&1
			echo "$SAVED"
		else
			echo "current clock is later, kept"
		fi
	else
		echo "no saved time"
	fi

	printf "Starting ntpd: "
	# -p per server. No -q and no -n: it forks and keeps the clock
	# disciplined rather than making the boot wait for a UDP round trip
	# that cannot succeed until the radio associates.
	OPTS=""
	for s in $SERVERS; do OPTS="$OPTS -p $s"; done
	# STEP EARLY, ONCE, THEN DISCIPLINE.
	#
	# There is no RTC, so the restored stamp is out by however long the
	# board was powered off - seventeen hours, in the case that exposed
	# this. ntpd corrects that with a STEP, because nothing sane slews
	# seventeen hours, and left to itself it steps whenever its first poll
	# happens to succeed. That is after the desktop is up and after a
	# person can have launched something.
	#
	# SDL 1.2 times with the WALL CLOCK (SDL_GetTicks is gettimeofday
	# based, not CLOCK_MONOTONIC), so an application running across the
	# step measures the step. prboom's timedemo reported 5026 gametics in
	# 2,134,306 realtics - 0.1 fps, and seventeen hours of "elapsed" time
	# in a four-minute run. Two such readings differed by 14.8 minutes,
	# which was exactly the real time between the two runs: the size of
	# the error is the age of the saved stamp, not anything about the
	# machine. A whole afternoon's measurements were called into question
	# by it, and the number is so wrong that it reads as a broken machine
	# rather than a broken clock.
	#
	# So: wait for a route in the background, take ONE step with -q, and
	# only then start the daemon. The step then lands a second or two
	# after the radio associates - around 35 s in, before the desktop
	# finishes starting - instead of at an arbitrary later moment. Still
	# nothing blocking: this is a background subshell and the boot does
	# not wait for it.
	#
	# It does not make the wall clock safe to measure with. It makes the
	# one unavoidable discontinuity land somewhere predictable.
	# "busybox ntpd", not "ntpd": the applet is compiled in, but the
	# /usr/sbin/ntpd symlink only exists if the rootfs was installed with
	# this busybox. Calling the applet by name works either way.
	(
		i=0
		while [ $i -lt 120 ]; do
			ip route | grep -q '^default' && break
			sleep 1
			i=$((i + 1))
		done
		# -q -n: step now and exit, in the foreground of this subshell.
		# Bounded by its own timeout so a dead uplink cannot leave the
		# daemon unstarted for ever.
		busybox timeout 30 busybox ntpd -q -n $OPTS >/dev/null 2>&1
		busybox ntpd $OPTS >/dev/null 2>&1
	) >/dev/null 2>&1 </dev/null &
	echo "OK (stepping in the background, then disciplining)"
}

stop() {
	printf "Saving clock: "
	save_time && echo "OK" || echo "FAIL"
	killall ntpd busybox 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	save) save_time ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|save|restart}"; exit 1 ;;
esac
