#!/bin/sh
#
# The LVGL desktop, replacing the X11 session.
#
# No X server: lvdesk drives KMS directly (dumb buffer, SETCRTC once, then
# DIRTYFB damage rectangles) and reads evdev itself. Xorg cost ~4.7 MB RSS
# against this program's ~0.4 MB.
#
case "$1" in
  start)
	printf "Starting lvdesk: "
	# /dev/dri/card0, NOT /dev/fb0. lvdesk used to draw through fbdev
	# emulation, which put an ~83 ms floor under every update - its
	# deferred-I/O worker batches damage on a timer, measured by writing a
	# single pixel to /dev/fb0 and timing the plane update. Going straight
	# to KMS took keystroke latency from ~100 ms to ~24 ms, one panel
	# frame. Testing for fb0 here would refuse to start on a kernel built
	# without the emulation lvdesk no longer uses.
	[ -e /dev/dri/card0 ] || { echo "no /dev/dri/card0"; exit 1; }
	# Switch the panel to its native 800x480 before the desktop starts.
	#
	# The console boots at 640x384 and stays there, on purpose: booting with
	# render= empty deadlocks fbcon. It is timing-dependent - the same image
	# hung at 3.8 s on one boot and 29.7 s on the next - and removing
	# console=tty0 makes that identical kernel boot straight through, which
	# places it in fbcon's console path. The commit hands its copy to a work
	# item because it runs with the CRTC lock held, and fbcon writes with the
	# console lock held; that is the pair to unpick.
	#
	# Switching here is a different matter: userspace is up, fbcon is idle,
	# and lvdesk takes DRM master immediately afterwards, which suspends the
	# in-kernel fbdev client altogether. The desktop then fills the panel
	# instead of sitting in an 80 px black frame.
	# printf, not echo: echo appends a newline, the parameter becomes "\n"
	# rather than empty, and the driver then rejects it as an unparseable
	# render= and skips the native path altogether.
	printf %s "" > /sys/module/esp32s31_lcd/parameters/render 2>/dev/null
	for c in /sys/class/drm/card0-*/status; do
		echo detect > "$c" 2>/dev/null
	done
	# /usr/bin, not /usr/sbin: S05xip overlays usr/lib, usr/bin, usr/libexec
	# and lib only, so a binary in /usr/sbin can never come from the XIP
	# image and pays full RSS for its text.
	# Stop the framebuffer console blinking its cursor. lvdesk takes DRM
	# master, which suspends the in-kernel fbdev client for as long as it
	# runs, so this now only matters for the console before the desktop
	# starts and if lvdesk ever exits - but it is cheap and fbcon's cursor
	# repaints the panel about five times a second forever: measured 50
	# plane updates per 10 s with it on against 1 with it off.
	echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
	setsid /usr/bin/lvdesk >/var/log/lvdesk.log 2>&1 </dev/null &
	echo "OK"
	;;
  stop)
	printf "Stopping lvdesk: "
	killall lvdesk 2>/dev/null
	echo "OK"
	;;
  restart|reload)
	"$0" stop; sleep 1; "$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"; exit 1
esac
