#!/bin/sh
#
# The LVGL desktop, replacing the X11 session.
#
# No X server: lvdesk draws straight into /dev/fb0 (DRM fbdev emulation) and
# reads evdev itself. Xorg cost ~4.7 MB RSS against this program's ~1.3 MB.
#
case "$1" in
  start)
	printf "Starting lvdesk: "
	[ -e /dev/fb0 ] || { echo "no /dev/fb0 (DRM_FBDEV_EMULATION off?)"; exit 1; }
	# /usr/bin, not /usr/sbin: S05xip overlays usr/lib, usr/bin, usr/libexec
	# and lib only, so a binary in /usr/sbin can never come from the XIP
	# image and pays full RSS for its text.
	# Stop the framebuffer console blinking its cursor underneath us. fbcon
	# comes up with DRM_FBDEV_EMULATION and its cursor repaints the panel
	# about five times a second forever: measured 50 plane updates per 10 s
	# with it on against 1 with it off, on a panel where a repaint costs
	# 24-48 ms. Same class of waste as jwm's taskbar clock.
	echo 0 > /sys/class/graphics/fbcon/cursor_blink 2>/dev/null
	setsid /usr/bin/lvdesk >/var/log/lvdesk.log 2>&1 </dev/null &
	echo "OK"
	;;
  stop)
	printf "Stopping lvdesk: "
	killall lvdesk 2>/dev/null
	echo "OK"
	;;
  restart|reload)
	"$0" stop; sleep 1; "$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"; exit 1
esac
