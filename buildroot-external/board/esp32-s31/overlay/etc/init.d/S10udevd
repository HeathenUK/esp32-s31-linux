#!/bin/sh
#
# udev	This is a minimal non-LSB version of a UDEV startup script.  It
#	was derived by stripping down the udev-058 LSB version for use
#	with buildroot on embedded hardware using Linux 2.6.34+ kernels.
#
#	You may need to customize this for your system's resource limits
#	(including startup time!) and administration.  For example, if
#	your early userspace has a custom initramfs or initrd you might
#	need /dev much earlier; or without hotpluggable busses (like USB,
#	PCMCIA, MMC/SD, and so on) your /dev might be static after boot.
#
#	This script assumes your system boots right into the eventual root
#	filesystem, and that init runs this udev script before any programs
#	needing more device nodes than the bare-bones set -- /dev/console,
#	/dev/zero, /dev/null -- that's needed to boot and run this script.
#

DAEMON="udevd"
PIDFILE="/var/run/$DAEMON.pid"

SETTLE_TIMEOUT=30
UDEVD_ARGS=""

# shellcheck source=/dev/null
[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

start() {
	printf "Starting %s: " "$DAEMON"
	[ -e /proc/sys/kernel/hotplug ] && printf '\000\000\000\000' > /proc/sys/kernel/hotplug
	# shellcheck disable=SC2086 # we need the word splitting
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "/sbin/$DAEMON" \
		-- $UDEVD_ARGS
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	# Coldplug in the BACKGROUND. Measured on this board: trigger is 11.2 s
	# and the settle after it 20.9 s, so blocking here cost 34 s of every
	# boot - half the time to a desktop - while the console printed
	# nothing, which is why it read as a hang at the last input device.
	#
	# Nothing in this system needs to wait for it. devtmpfs creates the
	# device nodes; udev here only applies rules and permissions. lvdesk
	# opens /dev/input itself and rescans every 2 s, so a device udev is
	# still processing is picked up when it appears rather than being
	# missed. The desktop now starts at 45 s instead of 83 s.
	# The coldplug is ~32 s of real work here - 269 devices, 27 rule files,
	# and a process launch costs 0.16 s on this board. Backgrounding it (the
	# previous fix) stopped it blocking the desktop but did NOT remove it:
	# it landed on top of S40network instead and starved it. Measured, same
	# boot, one variable:
	#
	#              coldplug at nice 0   at nice 19   udev not run at all
	#   ip link show      4.2 s           0.21 s          0.23 s
	#   iw dev info       4.4 s           0.23 s          0.23 s
	#   wpa_supplicant   20.8 s           2.4 s           2.1 s
	#   rcS complete     84.35 s          42.97 s         37.13 s
	#
	# So it was never the network: everything in that window ran ~20x slow.
	# At nice 19 udev still does its whole job (/dev/input and /dev/dri are
	# populated) and the foreground gets the CPU.
	nice -n 19 sh -c "udevadm trigger --type=subsystems --action=add; \
	  udevadm trigger --type=devices --action=add; \
	  udevadm settle --timeout=$SETTLE_TIMEOUT" &
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	udevadm control --exit
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
		return "$status"
	fi
	while start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE" \
		--exec "/sbin/$DAEMON"; do
		sleep 0.1
	done
	rm -f "$PIDFILE"
	return "$status"
}

restart() {
	stop
	start
}

reload() {
	printf "Reloading %s config: " "$DAEMON"
	udevadm control --reload
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start)
		start;;
	stop)
		stop;;
	restart)
		restart;;
	reload)
		reload;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac

exit $?
