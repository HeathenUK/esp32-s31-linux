#!/bin/sh
#
# Codec mixer state that must be set before anything plays.
#
# ADC2DAC Mixer is a SIDETONE: it routes the codec's ADC straight into its DAC.
# The es8389 powers up with it at 84 (66%, -11 dB), so the microphone has been
# feeding the speaker on this board by default, all the time.
#
# It matters most when nothing configures the ADC. Dropping the capture stream
# from the DAI - to give playback the whole SRAM pool - left the ADC
# unconfigured with this path still open, which put a loud hiss on the speaker
# and made playback sound hollow and distant. Muting it here is what makes that
# change safe, and it is worth doing regardless: a -11 dB open mic path is not
# something any of this board's uses want.
#
# amixer, not a driver patch: es8389 is mainline and this project does not
# patch mature upstream drivers. /etc is on the ext4 card, so `make deploy-etc`
# ships a change here.
#
# S38: after udev (S10) and the card exists, before lvdesk (S40) restores its
# stored volume.

case "$1" in
  start)
	printf "Muting codec sidetone: "
	# -95 dB. Not a switch, a volume - "0" is the floor, not "off".
	amixer -c 0 sset 'ADC2DAC Mixer' 0 >/dev/null 2>&1
	# And the ADC gains themselves, so nothing rides any other path.
	amixer -c 0 sset 'ADCL' 0 >/dev/null 2>&1
	amixer -c 0 sset 'ADCR' 0 >/dev/null 2>&1
	echo "OK"
	;;
  stop)
	;;
  restart|reload)
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
