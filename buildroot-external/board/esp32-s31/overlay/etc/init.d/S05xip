#!/bin/sh
#
# Execute the compositor's text in place from flash instead of faulting it off
# the SD card.
#
# This existed for a long time as a line in throwaway test scripts and was
# never wired into boot, which meant the measured benefit was never actually
# delivered on a running board. Measured with a fresh boot per arm, injecting
# pointer motion at 125 Hz and counting plane updates:
#
#     without      0.00  0.00  0.29  0.32  0.00  14.03 fps, still faulting
#     with         1.25  0.00 13.06 18.17 18.95  18.85 fps, majflt 0
#     weston RSS   872 kB  ->  92 kB
#
# LD_LIBRARY_PATH is NOT sufficient and must not be used instead: it only
# covers DT_NEEDED libraries, while weston dlopen()s its backend and shell by
# absolute path and the executable's own text is not a library at all. The
# overlay catches all three because it works on paths rather than on the
# loader's search order - which is also why the image has to be built with the
# real layout preserved. See rootfs/mkxipstage.py.

# These overlays are READ-ONLY: they are built from lowerdir alone, with no
# upperdir, because the flash images are cramfs and the point is to execute in
# place rather than to allow writes. So /usr/bin, /usr/lib, /usr/libexec and
# /lib cannot be written at runtime - `touch /usr/bin/x` gives EROFS.
#
# To replace a file there while the board is running, write to the SD copy
# underneath - /mnt/sd-usr-bin, /mnt/sd-usr-lib and so on - and remember the
# flash layer still wins for anything present in both. A script pushed to
# /usr/bin appears to succeed and changes nothing.

XIP_MNT=/mnt/xip
XIP2_MNT=/mnt/xip2

start() {
	printf 'Mounting XIP userspace: '
	mkdir -p "$XIP_MNT" || { echo "FAIL (mkdir)"; return 1; }
	if ! mount -t cramfs mtd:rootfs "$XIP_MNT" 2>/dev/null; then
		echo "skipped (no XIP image on mtd:rootfs)"
		return 0
	fi
	# Second image, in the slot that used to be `persist`. Optional: a board
	# without it just gets one layer.
	mkdir -p "$XIP2_MNT" 2>/dev/null
	mount -t cramfs mtd:xip2 "$XIP2_MNT" 2>/dev/null || XIP2_MNT=""
	# usr/share/fonts is here for a measured reason. Fonts were the single
	# largest source of major faults on this board: with them on the SD card
	# the desktop managed 1 plane update per 10 s and X took 987 major faults
	# in the same window; with a 768 kB font set in RAM it managed 87 updates
	# and 213 faults, and used 3.7 MB less swap. Same workload, one variable.
	#
	# They are read transiently while rendering rather than held mapped, so
	# inspecting a running server's mappings does not show them and makes the
	# cost invisible - only an A/B finds it.
	# usr/sbin and bin belong here as much as the rest, and their absence
	# was costing real money: the XIP image ALREADY contained
	# /usr/sbin/wpa_supplicant (784 KB), /usr/sbin/iw (256 KB) and
	# /bin/busybox (734 KB) - 1.77 MB of flash - while the loop below never
	# mounted those two directories, so every one of them ran from the SD
	# card instead and the flash copies were dead weight.
	#
	# Measured on one boot, same binary, one variable:
	#
	#     wpa_supplicant RSS   from SD 232 kB  ->  from XIP 88 kB
	#
	# It also showed up as boot time. S40network runs while lvdesk is still
	# faulting itself in, and wpa_supplicant demand-paged off the card under
	# that contention took 35.3 s to reach its daemonize, against 1.91 s warm.
	for d in usr/lib usr/bin usr/libexec usr/sbin lib bin sbin; do
		# Build the lower stack FIRST, and skip only if neither image
		# has the directory. This used to test $XIP_MNT/$d alone and
		# `continue` on it, so a directory living only in image 2 was
		# dropped before image 2 was ever consulted: /sbin holds ip and
		# udevd, both staged into image 2 and neither present in image
		# 1, so /sbin was silently never overlaid and both ran off the
		# card exactly as before. The flash was written, the image
		# mounted, the files were visibly there under /mnt/xip2 - and
		# nothing used them.
		#
		# lowerdir order matters: flash first so it wins, SD last so
		# anything absent from both images still resolves. Both flash
		# layers are searched before the card, and overlayfs merges
		# them, so an object only has to exist in one.
		lower=""
		[ -d "$XIP_MNT/$d" ] && lower="$XIP_MNT/$d"
		[ -n "$XIP2_MNT" ] && [ -d "$XIP2_MNT/$d" ] && \
			lower="${lower:+$lower:}$XIP2_MNT/$d"
		[ -n "$lower" ] || continue
		sd="/mnt/sd-$(echo "$d" | tr / -)"
		mkdir -p "$sd" || continue
		mount --bind "/$d" "$sd" || continue
		if ! mount -t overlay overlay \
			-o "lowerdir=$lower:$sd" "/$d"; then
			umount "$sd" 2>/dev/null
		fi
	done
	# Fonts REPLACE rather than merge. An overlay is wrong here: overlayfs
	# unions the directories, so all 334 fonts on the card stay visible and
	# fontconfig still walks every one of them off the SD. Measured, that is
	# worse than doing nothing - 5 plane updates per 10 s against 34 with no
	# font mount at all. A bind mount hides the card's set entirely, which is
	# what the experiment that found this actually did:
	#
	#     fonts on SD (334 faces)      1 update / 10 s
	#     fonts overlaid (merged)      5 updates / 10 s
	#     fonts bind-mounted (768 kB) 87 updates / 10 s
	#
	# The cache has to go with them: it indexes paths that are about to
	# disappear, and a stale cache sends fontconfig back to scanning.
	if [ -d "$XIP_MNT/usr/share/fonts" ]; then
		if mount --bind "$XIP_MNT/usr/share/fonts" /usr/share/fonts; then
			rm -rf /var/cache/fontconfig/* 2>/dev/null
		fi
	fi
	echo "OK ($(mount | grep -c 'type overlay') overlays)"
}

stop() {
	umount /usr/share/fonts 2>/dev/null
	for d in usr/lib usr/bin usr/libexec usr/sbin lib bin sbin; do
		umount "/$d" 2>/dev/null
		umount "/mnt/sd-$(echo "$d" | tr / -)" 2>/dev/null
	done
	umount "$XIP_MNT" 2>/dev/null
	umount "$XIP2_MNT" 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
