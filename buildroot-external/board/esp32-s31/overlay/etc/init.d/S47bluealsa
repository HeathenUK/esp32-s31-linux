#!/bin/sh
#
# BlueALSA: exposes A2DP as ALSA PCMs so BT audio needs no sound server.
# After S46bluetoothd - it registers its endpoints with bluez over D-Bus.
case "$1" in
  start)
	# DO NOT autostart. bluealsa's glib "pool-spawner" thread busy-waits
	# at ~92% of this board's single core with NO device connected and
	# nothing playing - measured 2026-09-02, system idle 0% with it
	# running against 65% without, and desktop input lag 170-411 ms
	# against 25 ms. It starved every other process on the machine and
	# was the real cause of "the desktop got slow during Bluetooth week".
	# The spin is in glib's thread pool under musl, not in Bluetooth: it
	# happens with the radio idle and the log clean.
	# Turn Bluetooth audio on with:  touch /etc/s31-btaudio-on
	if [ ! -f /etc/s31-btaudio-on ]; then
		echo "bluealsa: autostart off (touch /etc/s31-btaudio-on)"
		exit 0
	fi
	printf "Starting bluealsa: "
	setsid /usr/bin/bluealsa -p a2dp-source -p a2dp-sink \
		>/var/log/bluealsa.log 2>&1 </dev/null &
	echo "OK"
	;;
  stop)
	killall bluealsa 2>/dev/null
	;;
esac
