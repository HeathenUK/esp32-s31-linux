# Shared login/desktop policy for the validated SD-resident s31fp v3 release.
# The XIP v2 library remains the fallback if this installation is absent.
if [ -r /opt/s31/libs31fp.so ]; then
    export LD_PRELOAD=/opt/s31/libs31fp.so
    export S31FP_COPY=${S31FP_COPY:-1}
    export S31STR=${S31STR:-1}
    # The estimated fast clock is not accepted for deployment.
    export S31CLK=0
fi
