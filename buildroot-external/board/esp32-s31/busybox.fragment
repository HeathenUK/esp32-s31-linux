CONFIG_FEATURE_WGET_HTTPS=y
# CONFIG_SSL_SERVER is not set

# NTP client. This board has no RTC - no battery-backed chip on the Korvo-1
# (an I2C scan finds only the codec at 0x10 and touch at 0x14), and the SoC's
# RTC domain is not backed either - so every cold boot starts at the epoch
# until something tells it the time. busybox's own client is ~15 KB against
# chrony's ~400 KB, which matters on a 15.4 MB machine.
CONFIG_NTPD=y
# We are a client. Serving time to the network is not this board's job.
# CONFIG_FEATURE_NTPD_SERVER is not set
CONFIG_FEATURE_NTPD_CONF=y

# Link busybox statically.
#
# Dynamic linking costs ~38 ms on EVERY exec on this board, measured
# 2026-09-02 with rootfs/spawnbench.c: fork alone 13 ms, exec of a static
# 258 KB binary 14 ms, exec of dynamic busybox (734 KB) 52 ms. Size is not
# the variable - the ld.so resolve is. busybox is the shell behind every
# init script, every menu action and every helper the desktop spawns, so
# that 38 ms is paid hundreds of times during boot alone.
#
# It costs flash (libc is no longer shared with it) and nothing in RAM:
# the binary is file-backed in the XIP image, so its text stays at Rss 0.
CONFIG_STATIC=y
