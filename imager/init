#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Init for the SD imager kernel. Deliberately never mounts the card: the whole
# point is to own /dev/mmcblk0 exclusively so it can be written from block zero,
# which also makes this work on a blank or half-written card.
#
# The image is streamed, never stored - there is nowhere to store it, with ~14 MB
# of RAM and a 512 MB image.

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null

# Keep kernel chatter off the wire; hart0's own log lines still arrive, which is
# why the transfer is framed and checksummed rather than a bare pipe.
dmesg -n 1 2>/dev/null

CON=/dev/console

# The kernel hands an initramfs init no stdio, because /dev/console does not
# exist until devtmpfs is mounted above. Reattach it explicitly so that a stray
# unredirected write cannot land on whatever fd happens to be free.
exec 0< $CON 1> $CON 2>&1

# Raw is not cosmetic here: the image is binary, and a console left in cooked
# mode would echo every byte back at the sender and translate CR to LF inside
# the payload. -parenb cs8 keeps the line 8-bit clean.
stty -F $CON raw -echo -ixon -ixoff -parenb -cstopb cs8 2>/dev/null

i=0
while [ ! -b /dev/mmcblk0 ] && [ $i -lt 50 ]; do
	i=$((i + 1))
	sleep 1
done

if [ ! -b /dev/mmcblk0 ]; then
	echo "IMAGER_NO_CARD" > $CON
	while :; do sleep 10; done
fi

echo "IMAGER_READY" > $CON

# sdrecv: frames in on stdin, payload out on stdout, acks on fd 3.
#
# iflag=fullblock matters when reading from a pipe: without it dd writes
# whatever a single read() returned, so a 1M block size degenerates into a
# stream of short writes to the card.
sdrecv 3 < $CON 3> $CON | gunzip -c |
	dd of=/dev/mmcblk0 bs=1M iflag=fullblock 2>/tmp/ddlog
sync

# How much dd actually wrote decides how much of the card is read back. This
# busybox is built without FEATURE_DD_THIRD_STATUS_LINE, so there is no "N bytes
# copied" line to parse - only "N+M records out", counting whole and partial
# blocks. At bs=1M a partial block means the image was not a whole number of
# mebibytes, and the byte count is then unrecoverable from dd's output, so say so
# rather than hash the wrong length and report a mismatch as if the card were bad.
RECORDS=$(awk '/records out/ { print $1; exit }' /tmp/ddlog)
FULL=${RECORDS%%+*}
PART=${RECORDS##*+}
echo "IMAGER_WROTE ${RECORDS:-none}" > $CON

if [ -n "$FULL" ] && [ "$FULL" -gt 0 ] && [ "$PART" = "0" ]; then
	BYTES=$((FULL * 1048576))
	SUM=$(dd if=/dev/mmcblk0 bs=1M count=$FULL 2>/dev/null |
		md5sum | cut -d' ' -f1)
	echo "IMAGER_SUM $SUM" > $CON
else
	echo "IMAGER_NOSUM records=${RECORDS:-none}" > $CON
fi

echo "IMAGER_DONE" > $CON
while :; do sleep 10; done
