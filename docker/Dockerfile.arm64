# Native arm64 build environment for esp32-s31-linux.
#
# The amd64 image (docker/Dockerfile) mirrors CI but runs under Rosetta on
# Apple Silicon, because the published S31 toolchain is x86_64-only. This image
# runs natively in colima's ARM VM instead and builds the same toolchain from
# source via crosstool-NG, so nothing is emulated.
#
# ESP-IDF's own riscv32-esp-elf toolchain has an aarch64-linux-gnu build, so the
# bootloader half is native too.
#
# Trade-off: the toolchain no longer matches the release artifact CI verifies by
# patch SHA256, so build_linux_toolchain.py's own verification is what attests
# it (xesploop patches, xespv memcpy in libc).

FROM --platform=linux/arm64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# First group is the CI package set; second is what crosstool-NG needs to build
# GCC, binutils and musl from source; libusb is required or ESP-IDF's
# install.sh aborts verifying openocd.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bison bc build-essential ccache cpio device-tree-compiler flex gperf \
        libffi-dev libssl-dev ninja-build rsync unzip \
        ca-certificates curl git wget file python3 python3-pip python3-venv \
        libncurses-dev mtd-utils squashfs-tools xxd sudo libusb-1.0-0 \
        autoconf automake libtool-bin help2man texinfo gawk bzip2 patch \
        python3-dev xz-utils meson \
    && rm -rf /var/lib/apt/lists/*

ENV IDF_PATH=/opt/esp-idf
ENV ESP_IDF_REF=2067f3ae32b7e7b61a0f3a052df63d619cd7c61d

RUN git clone --filter=blob:none https://github.com/espressif/esp-idf.git "$IDF_PATH" \
    && git -C "$IDF_PATH" checkout "$ESP_IDF_REF" \
    && git -C "$IDF_PATH" submodule update --init --recursive --depth 1

# Neither Buildroot nor crosstool-NG will run as root. uid/gid match the host
# user so bind-mounted output stays writable there.
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
RUN if getent group "$BUILDER_GID" >/dev/null; then \
            groupmod -n builder "$(getent group "$BUILDER_GID" | cut -d: -f1)"; \
        else \
            groupadd -g "$BUILDER_GID" builder; \
        fi \
    && if getent passwd "$BUILDER_UID" >/dev/null; then \
            usermod -l builder -d /home/builder -m -g "$BUILDER_GID" \
                "$(getent passwd "$BUILDER_UID" | cut -d: -f1)"; \
        else \
            useradd -m -s /bin/bash -u "$BUILDER_UID" -g "$BUILDER_GID" builder; \
        fi \
    && echo 'builder ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/builder \
    && chown -R builder:builder "$IDF_PATH" /home/builder

RUN install -d -o builder -g builder /home/builder/.ccache

USER builder

RUN "$IDF_PATH/install.sh" esp32s31

WORKDIR /src

USER root
# idf.py requires cmake on PATH. ESP-IDF's install.sh does not always provide
# it. Late layer so the expensive install.sh above stays cached.
RUN apt-get update && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
RUN printf '. "$IDF_PATH/export.sh" >/dev/null 2>&1 || true\n' \
        > /etc/profile.d/esp-idf.sh
USER builder

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["make -n all"]
