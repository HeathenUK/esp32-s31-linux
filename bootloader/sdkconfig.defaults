# Console baud for hart0.
#
# This must live here, not in sdkconfig: idf.py regenerates sdkconfig on a fresh
# configure and silently discarded a hand edit of this option, producing firmware
# that still ran at 115200 while every other artifact said otherwise.
#
# CUSTOM is required because the Kconfig prompt is gated on it - with
# ESP_CONSOLE_UART_DEFAULT the baud is not settable at all and pins to 115200.
#
# 1000000 rather than 921600. This project sets CONFIG_PM_ENABLE=y, and with
# power management IDF drives the console from a 1 MHz REF_TICK; IDF's own help
# warns that rates between 500 kbps and 1 Mbps "may not be accurate", and 921600
# needs a divisor of 1.085 from 1 MHz - about 8% out, far beyond UART tolerance.
# 1 Mbps is divisor 1 exactly. It is exact on the Linux side too: UART0 there is
# clocked from the 40 MHz XTAL, so 40 MHz / 1 MHz = 40 with no fractional part.
#
# Keep in step with esp32s31_generic.dts stdout-path and both kernel cmdlines:
# UART0 has a single divisor shared by both harts, so whoever programs it last
# sets the rate for everyone.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=1000000

# Quad I/O: the kernel executes XIP from this flash, so the mode sets the
# instruction-fetch bandwidth for the whole system. The part (mfr 0x46, dev
# 0x4018) is a quad-capable SPI NOR. If a board ever fails to boot after this,
# reflash with DIO - the ROM loader is unaffected by this setting.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_S31_USB_HID_ENABLE=n
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y

# Classic-only BT, matching Espressif's own S31 A2DP example config
# (sdkconfig.defaults: BTDM_CTRL_MODE_BR_EDR_ONLY, BLE off). Combined BTDM
# mode enables and inits without error but the controller then answers
# Read_Local_Features with "BR/EDR Not Supported" (features[4] bit37), so
# the kernel refuses all classic security and bluez treats the adapter as
# LE-only. Classic-only is the vendor-validated shape.
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
