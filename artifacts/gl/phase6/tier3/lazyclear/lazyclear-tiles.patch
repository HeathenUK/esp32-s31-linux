+/* ------------------------------------------------------------ lazy clears */
+
+/*
+ * LAZY CLEARS (phase 6 tier 3). QuakeSpasm clears depth and colour in full
+ * every frame (the depth epochs never fit its near depths, and its world
+ * covers every row, so the dirty boxes stop recording): two 153.6 kB fills
+ * at 320x240 that run at PSRAM write-allocate speed - the lines written by
+ * the clear are evicted long before the world draw fetches them back.
+ * With a retained buffer (the caller reads it only after a sync: GLX
+ * presents after s31gl_frame_end) a full clear of whole rows only MARKS
+ * the rows pending, with the value; the rows are written when something
+ * can first touch them:
+ *  - a triangle: the fillers' ztri_rows sends every triangle whose rows
+ *    [ya, yb) leave dbc to zdb_tri -> zdb_grow, which writes the pending
+ *    rows among them (both buffers) before a pixel is drawn, and dbc is
+ *    narrowed to a range with none pending (lzok), so a triangle inside
+ *    rows already written costs the fillers' two compares, as before;
+ *  - lines, points, pixel rectangles and partial clears: zdb_grow, as for
+ *    the dirty boxes (bact is on while rows are pending);
+ *  - everything that reads the buffers or hands them on - the sync before
+ *    a present (tgl_ctx_sync), a bind, make-current, the depth buffer's
+ *    release or rebinding, glReadPixels / glCopyPixels / glCopyTex*, the
+ *    depth epochs' whole-buffer passes, a masked or partial clear:
+ *    zlz_flush writes every row still pending.
+ * A row is written exactly once with the value the clear would have
+ * written, before anything reads it or draws into it, so every buffer is
+ * the one the clear gives, bit for bit. What changes is when: the clear's
+ * lines are written right before the first span of the row fetches them,
+ * while they are still in the D-cache (64 kB, 2-way), instead of a whole
+ * 300 kB pass evicting them all first. S31GL_LAZYCLR=0: every clear
+ * written at once, as before (the board A/B arm).
+ */
+#ifndef S31GL_LAZYCLR_DEFAULT
+#define S31GL_LAZYCLR_DEFAULT 1
+#endif
+static int zlz_on = -1;
+
+static int zlz_enabled(void)
+{
+  if (zlz_on < 0) {
+    const char *e = getenv("S31GL_LAZYCLR");
+    zlz_on = e ? atoi(e) != 0 : S31GL_LAZYCLR_DEFAULT;
+  }
+  return zlz_on;
+}
+
+/* the first row >= y below n whose bit in rows is set (want) or clear
+   (!want), or n */
+static int lz_next(const unsigned int *rows, int n, int y, int want)
+{
+  int w, nw = (n + 31) >> 5;
+  unsigned int x;
+  if (y >= n) return n;
+  w = y >> 5;
+  x = want ? rows[w] : ~rows[w];
+  x &= ~0u << (y & 31);
+  while (x == 0) {
+    if (++w >= nw) return n;
+    x = want ? rows[w] : ~rows[w];
+  }
+  y = (w << 5) + __builtin_ctz(x);
+  return y < n ? y : n;
+}
+
+/* the last row < y with its bit set, or -1 */
+static int lz_prev(const unsigned int *rows, int y)
+{
+  int w;
+  unsigned int x;
+  if (y <= 0) return -1;
+  y--;
+  w = y >> 5;
+  x = rows[w] & (~0u >> (31 - (y & 31)));
+  while (x == 0) {
+    if (--w < 0) return -1;
+    x = rows[w];
+  }
+  return (w << 5) + 31 - __builtin_clz(x);
+}
+
+/* the layout of ZBuffer.lzb: lzw words of row bits (row y has a tile
+   pending in either buffer), then per row the pending tiles of colour,
+   then of depth. A tile is 1 << lzsh pixels of a row (32 at 320 wide: a
+   64-byte line of either buffer), at most 32 a row */
+#define LZ_ROWS(zb) ((zb)->lzb)
+#define LZ_T(zb, k) ((zb)->lzb + (zb)->lzw + (k) * (zb)->lzrows)
+
+/* write the pending tiles m of row y of buffer k */
+static void lz_tiles(ZBuffer *zb, int k, int y, unsigned int m)
+{
+  unsigned short *row = k ? zb->zbuf + y * zb->xsize
+                          : (unsigned short *)((char *)zb->pbuf + y * zb->linesize);
+  int sh = zb->lzsh;
+  while (m) {
+    int t0 = __builtin_ctz(m), t1 = t0 + __builtin_ctz(~(m >> t0));
+    int x0 = t0 << sh, x1 = t1 << sh;
+    if (x1 > zb->xsize) x1 = zb->xsize;
+    ZB_fill16(row + x0, zb->lzv[k], x1 - x0);
+    m &= t1 >= 32 ? 0 : ~0u << t1;
+  }
+}
+
+/* write what is pending of [x0, x1) x [y0, y1) (inside the buffer) */
+static void lz_rect(ZBuffer *zb, int x0, int y0, int x1, int y1)
+{
+  unsigned int *rows = LZ_ROWS(zb), *tc = LZ_T(zb, 0), *tz = LZ_T(zb, 1);
+  unsigned int t1 = (unsigned int)(x1 - 1) >> zb->lzsh;
+  unsigned int tm = (t1 >= 31 ? ~0u : (2u << t1) - 1) &
+                    (~0u << ((unsigned int)x0 >> zb->lzsh));
+  int n = zb->ysize, y, e;
+  for (y = lz_next(rows, n, y0, 1); y < y1; y = lz_next(rows, n, e, 1)) {
+    e = lz_next(rows, n, y, 0);
+    if (e > y1) e = y1;
+    for (; y < e; y++) {
+      unsigned int mc = tc[y] & tm, mz = tz[y] & tm;
+      if (mc) {
+        lz_tiles(zb, 0, y, mc);
+        if (!(tc[y] &= ~mc)) zb->lzn[0]--;
+      }
+      if (mz) {
+        lz_tiles(zb, 1, y, mz);
+        if (!(tz[y] &= ~mz)) zb->lzn[1]--;
+      }
+      if (!(tc[y] | tz[y])) rows[y >> 5] &= ~(1u << (y & 31));
+    }
+  }
+}
+
+/* zdb_grow / zdb_tri: [x0, x1) x [y0, y1) may be drawn into; the rows
+   are clamped to the buffer, x0 < x1 inside it */
+static void zlz_rect(GLContext *c, int x0, int y0, int x1, int y1)
+{
+  ZBuffer *zb = c->zb;
+  const unsigned int *rows = LZ_ROWS(zb);
+  int lo = zb->lzok[0], hi = zb->lzok[1], n = zb->ysize;
+  lz_rect(zb, x0, y0, x1, y1);
+  /* the widest range of rows with nothing pending around [y0, y1) (joined
+     to the last one when they meet), for the fillers' check; none when a
+     row of [y0, y1) still has tiles pending outside [x0, x1) */
+  if (lz_next(rows, n, y0, 1) < y1) {
+    zb->lzok[0] = zb->lzok[1] = 0;
+    return;
+  }
+  if (y0 <= hi && y1 >= lo && lo < hi) {
+    if (lo < y0) y0 = lo;
+    if (hi > y1) y1 = hi;
+  }
+  zb->lzok[0] = lz_prev(rows, y0) + 1;
+  zb->lzok[1] = lz_next(rows, n, y1, 1);
+}
+
+static unsigned int lz_full(const ZBuffer *zb)
+{
+  int t = ((zb->xsize - 1) >> zb->lzsh) + 1;
+  return t >= 32 ? ~0u : (1u << t) - 1;
+}
+
+void zlz_flush_slow(GLContext *c)
+{
+  ZBuffer *zb = c->zb;
+  unsigned int fm = lz_full(zb);
+  int n = zb->ysize, y, r, k;
+  for (k = 0; k < 2; k++) {
+    unsigned int *t = LZ_T(zb, k);
+    int whole = k || zb->linesize == zb->xsize * PSZB;
+    if (!zb->lzn[k]) continue;
+    for (y = 0; y < n; y++) {
+      if (!t[y]) continue;
+      if (t[y] == fm && whole) {
+        /* a run of whole rows (those a frame never drew into, written at
+           its present): one fill */
+        for (r = y + 1; r < n && t[r] == fm; r++) t[r] = 0;
+        ZB_fill16(k ? zb->zbuf + y * zb->xsize
+                    : (unsigned short *)((char *)zb->pbuf + y * zb->linesize),
+                  zb->lzv[k], (r - y) * zb->xsize);
+        t[y] = 0;
+        y = r - 1;
+      } else {
+        lz_tiles(zb, k, y, t[y]);
+        t[y] = 0;
+      }
+    }
+    zb->lzn[k] = 0;
+  }
+  memset(LZ_ROWS(zb), 0, (size_t)zb->lzw * sizeof(unsigned int));
+  zdb_set_chk(c);
+}
