+/* a full clear of rows [y0, y1) of buffer k to v: 1 if they are pending
+   now (nothing written), 0 if the caller writes them */
+static int zlz_mark(GLContext *c, int k, int y0, int y1, unsigned int v)
+{
+  ZBuffer *zb = c->zb;
+  unsigned int *t, fm;
+  int y;
+  if (!zb->retained || !zlz_enabled() || zb->ysize <= 0 || zb->xsize <= 0)
+    return 0;
+  if (zb->lzb == NULL || zb->lzrows != zb->ysize || zb->lzx != zb->xsize) {
+    int w = (zb->ysize + 31) >> 5, sh = 5;
+    unsigned int *nb;
+    if (zb->lzn[0] | zb->lzn[1]) zlz_flush_slow(c);
+    while ((((zb->xsize - 1) >> sh) + 1) > 32) sh++;
+    nb = gl_zalloc((w + 2 * zb->ysize) * (int)sizeof(unsigned int));
+    if (nb == NULL) return 0;
+    gl_free(zb->lzb);
+    zb->lzb = nb;
+    zb->lzw = w;
+    zb->lzrows = zb->ysize;
+    zb->lzx = zb->xsize;
+    zb->lzsh = sh;
