+/* ------------------------------------------------------------ segment hold */
+
+/*
+ * SEGMENT HOLD - XLITE-SHM minor 4 (docs/gl-plan-2026-09-25.md section 9,
+ * goal "windowed zero-copy"). Only our libGL asks, and only for a drawable
+ * that ping-pongs two MIT-SHM segments.
+ *
+ * MIT-SHM's contract is that the server has CONSUMED the segment when it
+ * has handled ShmPutImage, which is why xshim copies every put (see "COPY.
+ * Always." in mitshm_request: adopting the segment broke SDL and Doom, which
+ * reuse it at once). A client that ping-pongs two segments and waits for
+ * each one's ShmCompletion before drawing into it again can offer more: the
+ * window may SHOW the segment itself until the client's next put. Then the
+ * put is no copy at all - the window's pixels become the segment
+ * (px_adopted) and the desktop presents from it - and the completion is sent
+ * when the segment is let go, at the next whole-window put (or when the
+ * window takes its pixels back), not while the put is handled.
+ *
+ *   HoldSegments  CARD8 major (XLITE-SHM), CARD8 4, CARD16 length 3,
+ *                 CARD32 window, CARD32 on (1) / off (0)
+ *   reply         BYTE granted (0/1)
+ *
+ * Discovered through the extension name "XLITE-HOLD", like "XLITE-RSCALE".
+ * Granted for a depth-16 top-level the client owns that is not render
+ * scaled (XSHIM_HOLD=0 refuses everything). Only a put of the whole window
+ * at 0,0 from a writable segment of the same client, at the window's own
+ * stride, is held; anything else - and every put while the window is
+ * fullscreen, where the scanout alias already makes the one copy the
+ * present - takes the ordinary copy path, with an ordinary completion.
+ *
+ * No client can deadlock on it: a held segment is let go by the client's
+ * own next put, and a client that waits for a segment it has not followed
+ * with another put withdraws first (off: the window copies the segment into
+ * pixels of its own, and the completion goes out). A resize, a ShmDetach, a
+ * client exit or the window's destruction let go as well; ShmDetach copies
+ * first, so the desktop never reads a segment that is gone.
+ */
+static int xhold_on(void)
+{
+	static int v = -1;
+
+	if (v < 0) {
+		const char *e = getenv("XSHIM_HOLD");
+
+		v = !(e && strcmp(e, "0") == 0);
+		fprintf(stderr, "xshim: segment hold for our libGL %s\n",
+			v ? "ON" : "OFF (XSHIM_HOLD=0)");
+	}
+	return v;
+}
+
+/* Send the held put's ShmCompletion: the segment is no longer read. */
+static void hold_release(struct res *w)
+{
+	struct cli *hc;
+	uint8_t ev[16];
+
+	if (!w || !w->held)
+		return;
+	w->held = 0;
+	if (!w->held_ev || w->held_cli < 0 || w->held_cli >= MAXCLI ||
+	    cli[w->held_cli].fd < 0)
+		return;
+	hc = &cli[w->held_cli];
+	put32(ev + 0, w->held_did);
+	put16(ev + 4, 3);
+	ev[6] = MITSHM_MAJOR;
+	ev[7] = 0;
+	put32(ev + 8, w->held_seg);
+	put32(ev + 12, w->held_off);
+	send_event(hc, MITSHM_EVENT, ev, sizeof ev);
+	if (w->held_cli != cur_owner)
+		out_flush(hc);
+}
+
+/*
+ * The window takes its pixels back from a held segment: its own buffer, a
+ * copy of the frame on screen, then the completion. The desktop is told,
+ * because its image widget names the segment.
+ */
+static void hold_own(struct res *w)
+{
+	const void *seg_px;
+	size_t n;
+
+	if (!w)
+		return;
+	if (w->px_adopted && w->px) {
+		seg_px = w->px;
+		n = (size_t)w->w * w->h * 2;
+		w->px = NULL;
+		w->canary = 0;
+		w->px_adopted = 0;
+		if (px_alloc(w, w->w, w->h)) {
+			memcpy(w->px, seg_px, n);
+			w->hole = 0;
+			w->dirty = 1;
+			wr_touch(w);
+		} else {
+			w->w = w->h = 0;	/* nothing to draw */
+		}
+		hold_release(w);
+		notify_draw(w);
+		return;
+	}
+	hold_release(w);
+}
+
+static void xhold_request(struct cli *c, const uint8_t *r, int len)
+{
+	uint8_t d24[24];
+	struct res *w = len >= 12 ? res_find(get32(r + 4)) : NULL;
+	int on = len >= 12 ? get32(r + 8) != 0 : 0, ok = 0;
+
+	memset(d24, 0, sizeof d24);
+	if (w && w->type == R_WINDOW && w->parent == ROOT_ID &&
+	    w->owner == (int)(c - cli) && w->buf == w && !w->rs_of) {
+		if (!on) {
+			w->hold = 0;
+			hold_own(w);
+		} else if (xhold_on() && (w->bpp ? w->bpp : 2) == 2 && !w->rs) {
+			w->hold = 1;
+			ok = 1;
+		}
+	}
+	d24[0] = (uint8_t)ok;
+	send_reply(c, 0, d24, NULL, 0);
+	fprintf(stderr, "xshim: segment hold 0x%x %s: %s\n", w ? w->id : 0,
+		on ? "on" : "off", ok ? "granted" : on ? "refused" : "done");
+}
