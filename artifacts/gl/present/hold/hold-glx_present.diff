> /*
>  * SEGMENT HOLD, XLITE-SHM minor 4 HoldSegments(window, on) (lvdesk/xshim.c
>  * xhold_request, discovered as "XLITE-HOLD"). With two segments the server
>  * may present the window straight from the segment it was given and keep
>  * it until our next put: no copy per frame. The wait keeps its shape - a
>  * buffer is free once the server has processed the put AFTER its own - so
>  * the next put's serial becomes the buffer's pend_serial (glxi_surf_present),
>  * and a buffer not yet followed by a put is withdrawn instead of waited for
>  * (glxi_surf_wait). S31GL_HOLD=0 never asks. Returns 1 when granted.
>  */
> static int hold_wanted(void)
> {
> 	static int v = -1;
> 
> 	if (v < 0) {
> 		const char *e = getenv("S31GL_HOLD");
> 
> 		v = !(e && strcmp(e, "0") == 0);
> 	}
> 	return v;
> }
> 
> static int hold_ask(Display *dpy, Window win, int on)
> {
> 	int major, ev, er, ok = 0;
> 	xGenericReply rep;
> 	struct hold_req {
> 		CARD8 reqType, minor;
> 		CARD16 length;
> 		CARD32 window;
> 		CARD32 on;
> 	} *req;
> 
> 	if (!XQueryExtension(dpy, "XLITE-HOLD", &major, &ev, &er))
> 		return 0;
> 	LockDisplay(dpy);
> 	req = (struct hold_req *)_XGetRequest(dpy, (CARD8)major, sizeof(*req));
> 	if (req) {
> 		req->minor = 4;
> 		req->window = (CARD32)win;
> 		req->on = (CARD32)(on != 0);
> 		if (_XReply(dpy, (xReply *)&rep, 0, xTrue))
> 			ok = (rep.data00 & 0xff) == 1 ? 1 : 0;
> 	}
> 	UnlockDisplay(dpy);
> 	SyncHandle();
> 	return ok;
> }
