+static irqreturn_t dw_mci_interrupt(int irq, void *dev_id)
+{
+	struct dw_mci *host = dev_id;
+	u32 idsts, idinten;
+	unsigned long flags;
+	int budget = 32;
+
+	spin_lock_irqsave(&host->irq_handler_lock, flags);
+
