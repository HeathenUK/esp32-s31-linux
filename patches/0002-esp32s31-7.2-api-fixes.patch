+# Restored downstream: 7.x removed the ESP32 UART driver from mainline along
+# with its Kconfig and Makefile entries. This board's console is that driver,
+# so esp32_uart.c is carried out-of-tree and needs its config plumbing back.
+config SERIAL_ESP32
+	tristate "Espressif ESP32 UART support"
+	depends on XTENSA_PLATFORM_ESP32 || SOC_ESP32S31 || (COMPILE_TEST && OF)
+	select SERIAL_CORE
+	select SERIAL_CORE_CONSOLE
+	select SERIAL_EARLYCON
+
+config SERIAL_ESP32_UHCI
+	bool "ESP32-S31 UHCI UART DMA"
+	depends on SERIAL_ESP32
+	depends on ESP32S31_AHB_GDMA
+	depends on SOC_ESP32S31
+	select DMA_ENGINE
+
 endmenu
 
