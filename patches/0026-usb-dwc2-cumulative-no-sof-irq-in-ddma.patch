+	if (hsotg->params.speed == speed)
+		return;
+	dev_info(hsotg->dev, "root port -> %s speed%s\n",
+		 speed == DWC2_SPEED_PARAM_FULL ? "full" : "high",
+		 speed == DWC2_SPEED_PARAM_FULL ?
+		 " (a device behind the hub needs split transactions)" :
+		 " (trying: nothing left that needs splits)");
+
+	spin_lock_irqsave(&hsotg->lock, flags);
+	hsotg->params.speed = speed;
+	hcfg = dwc2_readl(hsotg, HCFG);
