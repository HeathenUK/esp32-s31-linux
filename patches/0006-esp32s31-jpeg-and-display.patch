+/* Copy one recorded frame out. Recording must be stopped. */
+int esp32s31_jpeg_rec_frame(u32 index, void __user *to, u32 *size, u64 *stamp_ns)
+{
+	struct esp32s31_ppa *ppa = esp32s31_ppa_instance;
+	struct jpeg_rec_frame *f;
+	int ret = 0;
+
+	if (!ppa)
+		return -ENODEV;
