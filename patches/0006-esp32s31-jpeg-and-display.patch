+	mutex_lock(&ppa->jpeg_rec_lock);
+	if (READ_ONCE(ppa->jpeg_rec_running)) { ret = -EBUSY; goto out; }
+	if (!ppa->jpeg_rec_buf || index >= ppa->jpeg_rec_n) { ret = -ENOENT; goto out; }
