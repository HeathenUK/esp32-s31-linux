@@ -180,6 +209,7 @@
 	error = input_setup_polling(input, gt1158_poll);
 	if (error)
 		return error;
+	input_set_max_poll_interval(input, 500);
 	input_set_poll_interval(input, poll_ms);
 
 	return input_register_device(input);
