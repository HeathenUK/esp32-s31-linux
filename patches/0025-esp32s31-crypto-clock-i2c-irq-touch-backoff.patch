 	gt1158_write_byte(client, GT1158_REG_COOR, 0);
-	/* Apply a runtime poll_ms change; reading it here keeps 0644 honest. */
-	if (input_get_poll_interval(input) != poll_ms)
-		input_set_poll_interval(input, poll_ms);
+	/*
+	 * Pick the interval for the NEXT poll. Reading the parameters here
+	 * keeps their 0644 honest: a change applies within one poll.
+	 */
+	{
+		unsigned int want = poll_ms;
+
+		if (n > 0)
+			ts->quiet = 0;
+		else if (ts->quiet < idle_after)
+			ts->quiet++;
+		if (idle_poll_ms && ts->quiet >= idle_after)
+			want = idle_poll_ms;
+		if (input_get_poll_interval(input) != want)
+			input_set_poll_interval(input, want);
+	}
 }
 
