+
+				/*
+				 * Capture runs the receiver as a slave off the
+				 * transmitter's clocks, because only the TX
+				 * section's BCK and WS (signals 25 and 27) reach
+				 * the pads. The receiver listens on its own
+				 * indices - I_BCK 29 and I_WS 30 - so those are
+				 * routed back in from the very pads the
+				 * transmitter drives. Without input-enable the
+				 * pad's input buffer stays off and the matrix
+				 * reads nothing, which looks exactly like a dead
+				 * microphone: the stream starts, no sample ever
+				 * arrives, and the read fails with EIO.
+				 */
+				rx-clk-pins {
+					pinmux = <ESP32S31_MATRIX_IN(3, 29, 0)>,
+						 <ESP32S31_MATRIX_IN(4, 30, 0)>;
+					bias-disable;
+					input-enable;
+				};
 			};
 
