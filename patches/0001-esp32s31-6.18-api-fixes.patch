--- /private/tmp/claude-501/-Users-gadyke-esp32-s31-linux/a3bd6c0f-a207-47f4-a361-ed252dbfd1da/scratchpad/kup/port618/arch/riscv/mm/cacheflush.c	2026-08-24 10:12:11.825485464 +0100
+++ linux-618-port/arch/riscv/mm/cacheflush.c	2026-08-24 10:13:44.014352795 +0100
@@ -99,9 +99,29 @@
 #ifdef CONFIG_MMU
 void flush_icache_pte(struct mm_struct *mm, pte_t pte)
 {
-	struct folio *folio = page_folio(pte_page(pte));
+	struct folio *folio;
+
+	/*
+	 * Not every executable PTE is backed by a struct page. cramfs with
+	 * CONFIG_CRAMFS_MTD maps XIP text straight out of the flash window
+	 * with remap_pfn_range(), and that window sits below PHYS_RAM_BASE,
+	 * so it has no memmap entry. page_folio() on such a pfn walks a wild
+	 * pointer and oopses in set_ptes() during execve.
+	 *
+	 * There is no folio to carry PG_dcache_clean for these, and nothing
+	 * wrote the flash through the D-cache, so only the I-cache needs to be
+	 * made coherent.
+	 */
+	if (!pfn_valid(pte_pfn(pte))) {
+		flush_icache_mm(mm, false);
+		return;
+	}
+
+	folio = page_folio(pte_page(pte));
 
 	if (!test_bit(PG_dcache_clean, &folio->flags.f)) {
+		esp32s31_cache_sync_for_exec(page_to_phys(pte_page(pte)),
+					    PAGE_SIZE);
 		flush_icache_mm(mm, false);
 		set_bit(PG_dcache_clean, &folio->flags.f);
 	}
