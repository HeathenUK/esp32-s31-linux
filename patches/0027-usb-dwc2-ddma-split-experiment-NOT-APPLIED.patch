+			"split ch%d hcint 0x%04x hfnum 0x%04x hcsplt 0x%08x hctsiz 0x%08x | compl %u halt %u ack %u nak %u nyet %u xacterr %u frmovrun %u dtgl %u\n",
+			chnum, hcint, dwc2_readl(hsotg, HFNUM) & 0x3fff,
+			dwc2_readl(hsotg, HCSPLT(chnum)),
+			dwc2_readl(hsotg, HCTSIZ(chnum)),
+			dwc2_split_stats[0], dwc2_split_stats[1],
+			dwc2_split_stats[5], dwc2_split_stats[4],
+			dwc2_split_stats[6], dwc2_split_stats[7],
+			dwc2_split_stats[9], dwc2_split_stats[10]);
+}
+
+/*
+ * Fallback for a core that halts after each split phase in descriptor
+ * mode (dwc2.split_sw_csplit=1): re-arm the same channel on the same
+ * descriptor, never release it. HCDMA and HCTSIZ survive a halt.
+ */
+static bool dwc2_split_rearm(struct dwc2_hsotg *hsotg,
+			     struct dwc2_host_chan *chan, int chnum,
+			     struct dwc2_qtd *qtd)
+{
+	u16 now = dwc2_hcd_get_frame_number(hsotg);
+	u32 hcsplt, hcchar;
+
+	if (!dwc2_split_sw_csplit)
+		return false;
+
+	if ((chan->hcint & HCINTMSK_ACK) && !chan->complete_split) {
+		chan->complete_split = 1;	/* the TT took the SSPLIT */
+		chan->split_frame = now;
+	} else if ((chan->hcint & HCINTMSK_NYET) && chan->complete_split) {
+		/* TT not done; retry CSPLIT unless the frame is gone */
+		if (dwc2_frame_num_gt(now,
+				      dwc2_frame_num_inc(chan->split_frame, 4)))
+			chan->complete_split = 0;
+	} else if (chan->hcint & HCINTMSK_NAK) {
+		chan->complete_split = 0;	/* nothing to report */
+	} else {
+		return false;
+	}
+
+	hcsplt = dwc2_readl(hsotg, HCSPLT(chnum));
+	hcsplt &= ~HCSPLT_COMPSPLT;
+	if (chan->complete_split)
+		hcsplt |= HCSPLT_COMPSPLT;
+	hcsplt |= HCSPLT_SPLTENA;
+	dwc2_writel(hsotg, hcsplt, HCSPLT(chnum));
+
+	hcchar = dwc2_readl(hsotg, HCCHAR(chnum));
+	hcchar |= HCCHAR_CHENA;
+	hcchar &= ~HCCHAR_CHDIS;
+	dwc2_writel(hsotg, hcchar, HCCHAR(chnum));
+	chan->hcint = 0;
+	return true;
+}
