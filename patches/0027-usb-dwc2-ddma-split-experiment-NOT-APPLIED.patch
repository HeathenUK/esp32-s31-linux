+static u32 dwc2_split_stats[16];
+
+static void dwc2_split_trace_event(struct dwc2_hsotg *hsotg,
+				   struct dwc2_host_chan *chan, int chnum,
+				   u32 hcint)
+{
+	static u32 events;
+	int b;
+
+	for (b = 0; b < 16; b++)
