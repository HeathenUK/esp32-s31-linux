// SPDX-License-Identifier: GPL-2.0+
/*
 * ESP32-S31 Device Tree Source
 */
/dts-v1/;
#include "esp32s31.dtsi"

/ {
	model = "Espressif ESP32-S31 S-mode (generic)";
	compatible = "espressif,esp32s31";

	chosen {
		stdout-path = "serial0:1000000n8";
	};
};

&systimer { status = "okay"; };

/*
 * ESP32-S31-Korvo-1: 800x480 RGB565 subboard on LCD_CAM.
 * Enabling this costs the USB Serial/JTAG debug port, because the panel's
 * R4/R5 lines are GPIO33/GPIO34, which double as its D-/D+ pads.
 */
&ppa {
	status = "okay";
};

&lcd {
	status = "okay";
};

/*
 * ESP32-S31-Korvo-1 microSD slot, 4-bit on GPIO20-25 (D0-D3, CLK, CMD).
 * Enabled in the base tree rather than through the sdmmc0 overlay because the
 * root filesystem lives on the card and must be mountable before userspace
 * could load an overlay. These pins are shared with the module's SPI NAND;
 * the board selects microSD by default.
 */
/*
 * The card's power switch, which nothing was driving.
 *
 * GPIO39 is BSP_SD_CTRL in Espressif's own board support - "active-low
 * power/switch control", asserted low - and until now Linux neither knew about
 * it nor drove it, so the pin floated low (permanently on) and the card could
 * never be power-cycled. That matters because esp_restart() resets the SoC and
 * not the card: a card interrupted mid-write holds DAT0 low, the first CMD0
 * times out against it, and nothing short of pulling the board's power clears
 * it. With a regulator here the MMC core cycles the card as part of normal
 * initialisation.
 *
 * Measured before wiring it: ENABLE1 bit 7 was 0, so the pad was not driven at
 * all, and toggling it does move the pin (GPIO_IN1 bit 7 follows). What is NOT
 * established is that a cycle here clears an already-wedged card - one attempt
 * with ~4 s off did not revive one. It should stop the state arising, which is
 * the more useful half.
 */
/ {
	sd_pwr: regulator-sd-vcc {
		compatible = "regulator-fixed";
		regulator-name = "sd-vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 39 GPIO_ACTIVE_LOW>;
		/* No enable-active-high: the switch asserts LOW, per the BSP. */
		regulator-boot-on;
		/* SD spec wants the rail stable before the first command. */
		startup-delay-us = <20000>;
	};
};

&sdmmc {
	status = "okay";
	vmmc-supply = <&sd_pwr>;
};

/ {
	panel {
		compatible = "espressif,sub3-800x480";

		port {
			panel_in: endpoint {
				remote-endpoint = <&lcd_out>;
			};
		};
	};
};

/*
 * ESP32-S31-Korvo-1 shares one I2C bus on GPIO0/GPIO1 between the audio codec
 * and the touch controller. hart0's codec driver is configured for different
 * pins, so Linux can own this controller without contending for the bus.
 */
&i2c1 {
	status = "okay";

	/*
	 * ES8389 audio codec. Control lives here rather than on hart0 because
	 * only one peripheral can drive the shared GPIO0/GPIO1 pads and Linux
	 * also needs the bus for the touch controller. The I2S data path is
	 * Linux's too, through the i2s0 controller below.
	 */
	codec: audio-codec@10 {
		compatible = "everest,es8389";
		reg = <0x10>;
			/*
			 * Espressif's own BSP for this board has
			 * BSP_I2S_MCLK as GPIO_NUM_NC: there is no MCLK
			 * trace to the codec. 0 selects the SCLK pin, so
			 * the codec clocks itself from the bit clock.
			 */
			everest,mclk-src = /bits/ 8 <0>;
		#sound-dai-cells = <0>;
	};

	/*
	 * GT1158 touch controller, same bus as the codec. Neither INT nor
	 * RESET is wired on this board (Espressif's BSP agrees), so the
	 * polled driver is the only one that can drive it - and, probed
	 * 2026-08-31, the only thing it needs: the part scans from power-on
	 * and just wants its status register acknowledged every cycle.
	 */
	touchscreen: touchscreen@14 {
		compatible = "goodix,gt1158-polled";
		reg = <0x14>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
	};
};

/*
 * Linux owns the I2S controller and the codec pads, so the GDMA reads the ALSA
 * buffer in place and hart0 is out of the audio path entirely. That requires
 * the loader to be built with S31_AUDIO_ENABLE off: the codec's MCLK, BCLK, WS
 * and data pins can only be driven by one of the two controllers.
 */
/*
 * AUDIO LIVES ON HART0. The codec's MCLK, BCLK, WS and data pins can only be
 * driven by one controller, so this and freertos_audio are mutually exclusive
 * and always change together - along with S31_AUDIO_ENABLE in the loader's
 * sdkconfig, which must be ON to match.
 */
&i2s0 {
	status = "disabled";
};

&freertos_audio {
	status = "okay";
};

/*
 * Speaker amplifier enable on GPIO7. hart0 asserted this during its codec
 * bring-up and left it high; with audio moved across, Linux holds it the same
 * way. A hog rather than a DAPM widget because nothing needs to toggle it --
 * output muting is the codec's job.
 */
&gpio {
	speaker-amp-hog {
		gpio-hog;
		gpios = <7 0>;
		output-high;
		line-name = "speaker-amp-enable";
	};
};

/ {
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ESP32-S31 Korvo-1";
		simple-audio-card,format = "i2s";
		/*
		 * No mclk-fs: this board has no MCLK line, so the codec
		 * clocks from BCLK and derives its own coefficients from
		 * the frame size. Claiming an MCLK would lie to it.
		 */

		/*
		 * The codec's INPUT1/INPUT2 are DAPM *input* endpoints, and
		 * DAPM leaves an endpoint disconnected unless the machine wires
		 * it to something. Without this the whole capture chain -
		 * PGAL/PGAR into ADCL/ADCR - stays powered down, the codec
		 * sends a constant sample forever, and a recording comes back
		 * as unvarying DC that looks like a working DMA carrying
		 * silence.
		 *
		 * The Korvo-1's mic array is analog on both inputs, which is
		 * also what the vendor BSP says: digital_mic = false.
		 */
		simple-audio-card,widgets = "Microphone", "Mic Array";
		simple-audio-card,routing =
			"INPUT1", "Mic Array",
			"INPUT2", "Mic Array";

		/*
		 * hart0 is the CPU side of the link: it owns I2S, the mixer,
		 * the ASRC lanes and the shared rings. Linux keeps the CODEC,
		 * because the ES8389 sits on an I2C bus Linux owns and only
		 * Linux has a driver for the part (the loader's audio core
		 * can drive an ES8311, which this board does not have). That
		 * split is what keeps the ALSA mixer controls - and so sink
		 * switching - on the Linux side where s31route expects them.
		 */
		simple-audio-card,cpu {
			sound-dai = <&freertos_audio>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};
};
