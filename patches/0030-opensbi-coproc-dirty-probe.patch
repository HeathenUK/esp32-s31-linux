+/*
+ * Does the PIE unit track its own dirty state?
+ *
+ * The state CSR takes 0..3 and the accessors use INITIAL/CLEAN/DIRTY names,
+ * which is the RISC-V extension-state encoding. If the hardware raises the
+ * state to DIRTY by itself when a vector instruction executes, then the
+ * per-switch save can be skipped whenever the outgoing task left it CLEAN -
+ * which is what makes a lazy save possible, and lazy saving is the only way
+ * to keep the coprocessor's correctness AND its ~50 us per switch.
+ *
+ * Nothing in docs/s31_hardware records the answer, so ask the silicon: set
+ * CLEAN, execute one vector load, read the state back. Printed once at boot.
+ */
+static unsigned long esp32s31_probe_coproc_dirty(void)
+{
+	unsigned long before, after, scratch[4] __attribute__((aligned(16)));
+
+	scratch[0] = scratch[1] = scratch[2] = scratch[3] = 0;
+
+	/* Enable, then declare the state CLEAN. */
+	__asm__ volatile ("csrwi 0x7f2, 1");	/* INITIAL: enables access */
+	__asm__ volatile ("csrwi 0x7f2, 2");	/* CLEAN */
+	before = csr_read(0x7f2);
+
+	/* esp.vld.128.ip q0, a0, 0 - one vector load from scratch. */
+	__asm__ volatile (
+		"mv a0, %0\n"
+		".word 0x0311001f\n"
+		: : "r" (scratch) : "a0", "memory");
+
+	after = csr_read(0x7f2);
+	/* Packed so one SBI return carries both readings: before | after << 8. */
+	return (before & 0xff) | ((after & 0xff) << 8);
+}
