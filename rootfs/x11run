#!/bin/sh
# Run an off-the-shelf X11 client against lvdesk's built-in X shim.
#
# There is no X server. lvdesk speaks the X core protocol itself on
# /tmp/.X11-unix/X0 (see docs/x11-shim.md), so a client just needs to be
# pointed at it and told where its libraries and app-defaults live.
#
#   x11run xcalc
#   x11run xclock -update 1
#
# The three environment variables are all needed and each fails differently:
#   DISPLAY           - without it the client will not start at all
#   LD_LIBRARY_PATH   - without it the loader cannot find libX11 and friends
#   XFILESEARCHPATH   - without it an Xt/Xaw app builds its widget tree with no
#                       resources and lays itself out degenerately. xcalc came
#                       up as an 82x40 box for exactly this reason, which looks
#                       like a broken server and is not.
X11=/root/x11
[ -n "$1" ] || { echo "usage: x11run <client> [args]" >&2; exit 1; }
[ -x "$X11/usr/bin/$1" ] || { echo "x11run: no such client: $1" >&2
	echo "available:" >&2; ls "$X11/usr/bin" >&2; exit 1; }
prog=$1; shift
export DISPLAY=:0
# xlite (our own libX11) first when it is present, then the stock chain.
# Without this the loader finds the real 1.3 MB libX11 and every measurement
# silently describes the wrong library.
if [ -f /root/xlite/libX11.so.6 ]; then
	export LD_LIBRARY_PATH=/root/xlite:$X11/usr/lib
else
	export LD_LIBRARY_PATH=$X11/usr/lib
fi
export XFILESEARCHPATH=$X11/usr/share/X11/app-defaults/%N
exec "$X11/usr/bin/$prog" "$@"
